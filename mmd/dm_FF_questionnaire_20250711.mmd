classDiagram
direction TB
    class Vault {
        <<Entity>>
	    +vaultId: xs:string
    }

    class QuestionnaireResponse {
        <<Entity>>
	    +id questionnaireResponseId : string
	    +questionnaireResponseStatus : string
	    +questionnaireResponseDateTime : datetime
      +lastUpdated : datetime (recommended)
      +schemaVersion : string (recommended)
    }

    class Questionnaire {
        <<Entity>>
	    +id questionnaireId: string
	    +questionnaireLabel : string
    }

    class Section {
        <<Entity>>
	    +id sectionId : string
	    +rdfs:label sectionLabel : string
    }

    class Question {
        <<Entity>>
	    +id questionId : string
	    +questionLabel : string
	    +questionType : QuestionType
      +numericalQuestionParams : NumericalParams (optional)
      +intervalQuestionParams : IntervalParams (optional)
      +codingQuestionParams : ValueCoding (optional)
      +questionRequired : bool
    }

    class Answer {
        <<Entity>>
	    +id answerId : string
	    +qestionType : QuestionType
      +isEmptyAnswer : bool 
      +answerValue : array OR null (recommended)
    }

    class AnswerOption {
        <<Value>>
	    rdf:list 
    }

    class QuestionType {
        <<enumeration>>
	    choice
        open-choice
        decimal
        number
        date
        text
    }

    class rdf {
        <<Value>>
	    rdf:nil // Empty Array
    }

    class ValueString {
        <<Value>>
	    +rdf:type : xsd:string
    }

    class ValueDecimal {
        <<Value>>
	    +rdf:type : xsd:decimal OR xsd:integer
    }

    class ValueCoding {
        <<Value>>
	    +code: xsd:string
	    +display: xsd:string
    }

    class minValue {
        <<Value>>
        rdf:type : xsd:integer
    }

    class maxValue {
        <<Value>>
        rdf:type : xsd:integer
    }

    class ValueDate {
        <<Value>>
	    +rdf:type : xsd:dateTime
    }

    note for ValueCoding "For type=open-choice, the last ValueCoding must be: {valueCoding: {'code': '-1', 'display': 'Other'}}"

    Vault --> "0..*" QuestionnaireResponse : "hasQuestionnaireResponse"
    QuestionnaireResponse --> "1" Vault : "bySubject"
    QuestionnaireResponse --> "1" Questionnaire : "isResponseFor"
    QuestionnaireResponse "1" --> "1..*" Answer : "hasResponseAnswer"
    Questionnaire --> "0..*" QuestionnaireResponse : "hasResponse"
    Questionnaire --> "0..*" Section : "questionnaireHasSection"
    Questionnaire --> "1..*" Question : "questionnaireHasQuestion"
    Section --> "1..*" Questionnaire : "sectionPartOfQuestionnaire"
    Section "0..*" <--> "0..*" Section : "sectionHasSection" / "sectionPartOfSection"
    Section --> "1" Questionnaire : "moveUp_partOfQuestionnaire"
    Section --> "0..*" Question : "sectionHasQuestion"
    Question --> "0..*" Section : "questionPartOfSection"
    Question --> "0..*" Answer : "hasAnswer"
    Question --> "1..*" Questionnaire : "partOfQuestionnaire"
    Answer --> "1" QuestionnaireResponse : "isAnswerIn"
    Answer --> "1" Question : "toQuestion"

    Answer --|> "0..1" AnswerOption  : if type=choice/open-choice/number
    AnswerOption --|> "0..*" ValueCoding : if type=choice/open-choice
    AnswerOption --|> "1" minValue : if type=number
    AnswerOption --|> "1" maxValue : if type=number
    AnswerOption --|> "1" ValueCoding : if type=number 
    Answer --|> "0..1" ValueDecimal : if type=decimal
    AnswerOption --|> "0..1" ValueString : if type=open-choice
    Answer --|> "0..1" ValueString : if type=text
    Answer --|> "0..1" ValueDate : if type=date
    Answer --|> "0..1" rdf

