# metamodel_version: 1.7.0
# version: 2.0.0
BASE <https://ns.faqir.org/q-o#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX fhir: <http://hl7.org/fhir/>
PREFIX phro: <https://ns.faqir.org/phr-o#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX s4ehaw: <https://saref.etsi.org/saref4ehaw/>
PREFIX ucum: <https://unitsofmeasure.org/>
PREFIX linkml: <https://w3id.org/linkml/>


linkml:String xsd:string

linkml:Integer xsd:integer

linkml:Boolean xsd:boolean

linkml:Float xsd:float

linkml:Double xsd:double

linkml:Decimal xsd:decimal

linkml:Time xsd:time

linkml:Date xsd:date

linkml:Datetime xsd:dateTime

linkml:DateOrDatetime linkml:DateOrDatetime

linkml:Uriorcurie IRI

linkml:Curie xsd:string

linkml:Uri IRI

linkml:Ncname xsd:string

linkml:Objectidentifier IRI

linkml:Nodeidentifier NONLITERAL

linkml:Jsonpointer xsd:string

linkml:Jsonpath xsd:string

linkml:Sparqlpath xsd:string

<FhirProcedure> CLOSED {
    (  $<FhirProcedure_tes> (  &<SuloProcess_tes> ;
          rdf:type [ <https://aidava-dev.github.io/sulo/ontospy/index.htmlProcess> ] ?
       ) ;
       rdf:type [ fhir:Procedure ] ?
    )
}

<FhirReferenceRange> CLOSED {
    (  $<FhirReferenceRange_tes> (  phro:lowRange @<QuantityValue> ? ;
          phro:highRange @<QuantityValue> ? ;
          phro:normalValue @<QuantityValue> *
       ) ;
       rdf:type [ fhir:Observation.referenceRange ] ?
    )
}

<FhirValueRatio> CLOSED {
    (  $<FhirValueRatio_tes> (  fhir:numerator @<QuantityValue> ;
          fhir:denominator @<QuantityValue>
       ) ;
       rdf:type [ fhir:datatype.Ratio ] ?
    )
}

<FoafAgent>  (
    CLOSED {
       (  $<FoafAgent_tes> (  &<OwlThing_tes> ;
             rdf:type [ owl:Thing ] ? ;
             prov:type @linkml:Uriorcurie * ;
             dcterms:hasPart @<OwlThing> * ;
             dcterms:isPartOf @<OwlThing> * ;
             prov:generatedAtTime @linkml:Datetime * ;
             fhir:resource-status @<SarefPropertyValue> * ;
             dcterms:creator @<FoafAgent> * ;
             saref:hasProperty @<SarefProperty> * ;
             saref:hasPropertyValue @<SarefPropertyValue> *
          ) ;
          rdf:type [ foaf:Agent ] ?
       )
    } OR @<FoafPerson> OR @<ProvOrganization>
)

<FoafPerson> CLOSED {
    (  $<FoafPerson_tes> (  &<FoafAgent_tes> ;
          rdf:type [ foaf:Agent ] ?
       ) ;
       rdf:type [ foaf:Person ] ?
    )
}

<IntervalParams> CLOSED {
    (  $<IntervalParams_tes> (  phro:minValue @linkml:Float ? ;
          phro:minLabel @linkml:String ? ;
          phro:maxValue @linkml:Float ? ;
          phro:maxLabel @linkml:String ?
       ) ;
       rdf:type [ phro:IntervalParams ] ?
    )
}

<NumericalParams> CLOSED {
    (  $<NumericalParams_tes> (  ucum:units @linkml:Uriorcurie ? ;
          phro:precision @linkml:Integer ?
       ) ;
       rdf:type [ phro:NumericalParams ] ?
    )
}

<OwlThing>  (
    CLOSED {
       (  $<OwlThing_tes> (  owl:versionInfo @linkml:String ? ;
             rdfs:label @linkml:String + ;
             rdfs:comment @linkml:String + ;
             prov:hadPrimarySource @<ProvEntity> * ;
             prov:wasGeneratedBy @<SuloProcess> *
          ) ;
          rdf:type [ owl:Thing ] ?
       )
    } OR @<FoafAgent> OR @<ProvEntity> OR @<SuloProcess>
)

<ProvAttribution> CLOSED {
    (  $<ProvAttribution_tes> rdf:type . * ;
       rdf:type [ prov:Attribution ] ?
    )
}

<ProvEntity>  (
    CLOSED {
       (  $<ProvEntity_tes> (  &<OwlThing_tes> ;
             rdf:type [ owl:Thing ] ? ;
             prov:wasAttributedTo @<FoafAgent> * ;
             dcterms:created @linkml:Datetime ? ;
             dcterms:modified @linkml:Datetime ? ;
             prov:type @linkml:Uriorcurie * ;
             dcterms:hasPart @<OwlThing> * ;
             dcterms:isPartOf @<OwlThing> * ;
             prov:generatedAtTime @linkml:Datetime * ;
             fhir:resource-status @<SarefPropertyValue> * ;
             dcterms:creator @<FoafAgent> * ;
             saref:hasProperty @<SarefProperty> * ;
             saref:hasPropertyValue @<SarefPropertyValue> *
          ) ;
          rdf:type [ prov:Entity ] ?
       )
    } OR @<QoAnswer> OR @<QoOrderedQuestion> OR @<QoOrderedSection> OR @<QoQuestion> OR @<QoQuestionnaire> OR
    @<QoQuestionnaireResponse> OR @<QoSection> OR @<SarefProperty> OR @<SarefPropertyValue>
)

<ProvOrganization> CLOSED {
    (  $<ProvOrganization_tes> (  &<FoafAgent_tes> ;
          rdf:type [ foaf:Agent ] ?
       ) ;
       rdf:type [ prov:Organization ] ?
    )
}

<QoAnswer> CLOSED {
    (  $<QoAnswer_tes> (  &<ProvEntity_tes> ;
          rdf:type [ prov:Entity ] ? ;
          <toQuestion> @<QoQuestion> ;
          <answerValue> @linkml:String ? ;
          <isEmpty> @linkml:Boolean ? ;
          prov:generatedAtTime @linkml:Datetime +
       ) ;
       rdf:type [ <Answer> ] ?
    )
}

<QoOrderedQuestion> CLOSED {
    (  $<QoOrderedQuestion_tes> (  &<ProvEntity_tes> ;
          rdf:type [ prov:Entity ] ? ;
          <question> @<QoQuestion> ;
          <hardValidity> @linkml:Boolean ? ;
          <temporalValidity> @<TimeDuration> ;
          <conditionalValidity> @linkml:String ;
          <order> @linkml:Integer ;
          <required> @linkml:Boolean
       ) ;
       rdf:type [ <OrderedQuestion> ] ?
    )
}

<QoOrderedSection> CLOSED {
    (  $<QoOrderedSection_tes> (  &<ProvEntity_tes> ;
          rdf:type [ prov:Entity ] ? ;
          <section> @<QoSection> ;
          <order> @linkml:Integer
       ) ;
       rdf:type [ <OrderedSection> ] ?
    )
}

<QoQuestion> CLOSED {
    (  $<QoQuestion_tes> (  &<ProvEntity_tes> ;
          rdf:type [ prov:Entity ] ? ;
          <multivalued> @linkml:Boolean ? ;
          <tag> @linkml:String + ;
          <numericalParams> @<NumericalParams> ? ;
          <codingParams> @<ValueCoding> * ;
          <codingOrdinal> @linkml:Boolean ? ;
          <intervalParams> @<IntervalParams> ? ;
          prov:type [ <http://hl7.org/fhir/item-type#coding> <open-choice> <numberInterval> <http://hl7.org/fhir/item-type#decimal>
             <http://hl7.org/fhir/item-type#time> <http://hl7.org/fhir/item-type#dateTime> <http://hl7.org/fhir/item-type#string> ]
          + ;
          dcterms:creator @<ProvOrganization> +
       ) ;
       rdf:type [ <Question> ] ?
    )
}

<QoQuestionnaire> CLOSED {
    (  $<QoQuestionnaire_tes> (  &<ProvEntity_tes> ;
          rdf:type [ prov:Entity ] ? ;
          <hasOrderedQuestion> @<QoOrderedQuestion> * ;
          <hasOrderedSection> @<QoOrderedSection> * ;
          dcterms:created @linkml:Datetime ;
          dcterms:modified @linkml:Datetime ;
          dcterms:creator @<ProvOrganization> + ;
          dcterms:isPartOf @<SuloProcess> * ;
          fhir:resource-status @<QoQuestionnaireStatus> +
       ) ;
       rdf:type [ <Questionnaire> ] ?
    )
}

<QoQuestionnaireResponse> CLOSED {
    (  $<QoQuestionnaireResponse_tes> (  &<ProvEntity_tes> ;
          rdf:type [ prov:Entity ] ? ;
          <responds> @<QoQuestionnaire> ;
          <hasAnswer> @<QoAnswer> + ;
          dcterms:created @linkml:Datetime ;
          dcterms:modified @linkml:Datetime ;
          dcterms:isPartOf @<SuloProcess> * ;
          prov:wasAttributedTo @<FoafPerson> + ;
          fhir:resource-status @<QoQuestionnaireResponseStatus> +
       ) ;
       rdf:type [ <QuestionnaireResponse> ] ?
    )
}

<QoQuestionnaireResponseStatus> CLOSED {
    (  $<QoQuestionnaireResponseStatus_tes> (  &<SarefPropertyValue_tes> ;
          rdf:type [ saref:PropertyValue ] ? ;
          saref:hasValue [ fhir:questionnaire-answers-status-in-progress fhir:questionnaire-answers-status-completed
             fhir:questionnaire-answers-status-amended fhir:questionnaire-answers-status-entered-in-error
             fhir:questionnaire-answers-status-stopped ]
       ) ;
       rdf:type [ <QuestionnaireResponseStatus> ] ?
    )
}

<QoQuestionnaireStatus> CLOSED {
    (  $<QoQuestionnaireStatus_tes> (  &<SarefPropertyValue_tes> ;
          rdf:type [ saref:PropertyValue ] ? ;
          saref:hasValue [ fhir:resource-status-draft fhir:resource-status-active fhir:resource-status-retired
             fhir:resource-status-unknown ]
       ) ;
       rdf:type [ <QuestionnaireStatus> ] ?
    )
}

<QoSection> CLOSED {
    (  $<QoSection_tes> (  &<ProvEntity_tes> ;
          rdf:type [ prov:Entity ] ? ;
          <hasOrderedQuestion> @<QoOrderedQuestion> * ;
          <hasOrderedSection> @<QoOrderedSection> * ;
          dcterms:creator @<ProvOrganization> +
       ) ;
       rdf:type [ <Section> ] ?
    )
}

<QuantityValue> CLOSED {
    (  $<QuantityValue_tes> (  saref:isMeasuredIn @linkml:Uriorcurie ? ;
          saref:hasValue @linkml:String ?
       ) ;
       rdf:type [ fhir:datatypes.Quantity ] ?
    )
}

<S4ehawActivity> CLOSED {
    (  $<S4ehawActivity_tes> (  &<SuloProcess_tes> ;
          rdf:type [ <https://aidava-dev.github.io/sulo/ontospy/index.htmlProcess> ] ?
       ) ;
       rdf:type [ s4ehaw:activity ] ?
    )
}

<SarefProperty> CLOSED {
    (  $<SarefProperty_tes> (  &<ProvEntity_tes> ;
          rdf:type [ prov:Entity ] ? ;
          fhir:Observation.referenceRange @<FhirReferenceRange> ?
       ) ;
       rdf:type [ saref:Property ] ?
    )
}

<SarefPropertyValue>  (
    CLOSED {
       (  $<SarefPropertyValue_tes> (  &<ProvEntity_tes> ;
             rdf:type [ prov:Entity ] ? ;
             prov:atTime @linkml:Datetime ? ;
             saref:hasValue @linkml:String ? ;
             saref:isValueOfProperty @<SarefProperty> ? ;
             fhir:valueReference @linkml:Uriorcurie ? ;
             fhir:valueCodeableConcept @<ValueCoding> ? ;
             fhir:valueRange @<FhirReferenceRange> ? ;
             fhir:valueRatio @<FhirValueRatio> ? ;
             fhir:valuePeriod @<TimeInterval> ? ;
             fhir:valueAttachement @linkml:Uriorcurie ?
          ) ;
          rdf:type [ saref:PropertyValue ] ?
       )
    } OR @<QoQuestionnaireResponseStatus> OR @<QoQuestionnaireStatus>
)

<SuloProcess>  (
    CLOSED {
       (  $<SuloProcess_tes> (  &<OwlThing_tes> ;
             rdf:type [ owl:Thing ] ? ;
             prov:type @linkml:Uriorcurie * ;
             dcterms:hasPart @<OwlThing> * ;
             dcterms:isPartOf @<OwlThing> * ;
             prov:generatedAtTime @linkml:Datetime * ;
             fhir:resource-status @<SarefPropertyValue> * ;
             dcterms:creator @<FoafAgent> * ;
             saref:hasProperty @<SarefProperty> * ;
             saref:hasPropertyValue @<SarefPropertyValue> *
          ) ;
          rdf:type [ <https://aidava-dev.github.io/sulo/ontospy/index.htmlProcess> ] ?
       )
    } OR @<FhirProcedure> OR @<S4ehawActivity>
)

<TimeDuration> CLOSED {
    (  $<TimeDuration_tes> (  saref:hasValue @linkml:String ? ;
          saref:isMeasuredIn @linkml:Uriorcurie ?
       ) ;
       rdf:type [ time:Duration ] ?
    )
}

<TimeInterval> CLOSED {
    (  $<TimeInterval_tes> (  prov:startedAtTime @linkml:Datetime ? ;
          prov:endedAtTime @linkml:Datetime ?
       ) ;
       rdf:type [ time:Interval ] ?
    )
}

<ValueCoding> CLOSED {
    (  $<ValueCoding_tes> (  fhir:code @linkml:String ;
          fhir:display @linkml:String
       ) ;
       rdf:type [ fhir:Coding ] ?
    )
}

