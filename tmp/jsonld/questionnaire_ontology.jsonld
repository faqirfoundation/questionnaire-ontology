      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "qo_tag",
          "description": "Internal English identifier, e.g., 'q_pain_level'.",
          "slot_uri": "qo:tag",
          "range": "string",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "qo_numericalParams",
          "description": "Unit and Precision limiting the quantitative answer for the question.",
          "slot_uri": "qo:numericalParams",
          "range": "NumericalParams",
          "@type": "SlotDefinition"
        },
        {
          "name": "qo_codingParams",
          "description": "Code and Display of each option offered as answer to the choice or open-choice question.",
          "slot_uri": "qo:codingParams",
          "range": "ValueCoding",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "qo_codingOrdinal",
          "description": "Indicates if the choices in a choice or open-choice question are ordered (true) or unordered (false, categorical).",
          "slot_uri": "qo:codingOrdinal",
          "ifabsent": "False",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "qo_intervalParams",
          "description": "Minimum and Maximum limiting the range the answer must be in for the question.",
          "slot_uri": "qo:intervalParams",
          "range": "IntervalParams",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://ns.faqir.org/q-o#Question",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "prov_type",
                "equals_string_in": [
                  "choice",
                  "openChoice"
                ],
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "qo_codingParams",
                "required": true,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "If prov_type is 'choice' or 'openChoice', codingParams is required.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "prov_type",
                "equals_string_in": [
                  "numberInterval"
                ],
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "qo_numericalParams",
                "required": true,
                "@type": "SlotDefinition"
              },
              {
                "name": "qo_intervalParams",
                "required": true,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "If prov_type is 'numberInterval', numericalParams and intervalParams are required.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "prov_type",
                "equals_string_in": [
                  "decimal"
                ],
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "qo_numericalParams",
                "required": true,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "If prov_type is 'decimal', numericalParams is required.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
