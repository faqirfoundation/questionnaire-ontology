    {
      "name": "Answer",
      "definition_uri": "https://w3id.org/faqir/datamodel/questionnaire/classes/Answer",
      "description": "Answer in the questionnaire response.",
      "from_schema": "https://w3id.org/faqir/datamodel/questionnaire/classes",
      "mappings": [
        "faqir:Answer",
        "fhir:QuestionnaireResponse.item.answer"
      ],
      "slots": [
        "answerInQuestionnaireResponse",
        "answerToQuestion",
        "questionType",
        "answer__answerId",
        "answer__answerValueNumerical",
        "answer__answerValueString",
        "answer__answerValueDateTime",
        "answer__answerIsEmpty",
        "answer__answerTimeStamp"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "answerId",
          "description": "The unique identifier for an answer in the questionnaire response.",
          "identifier": true,
          "range": "uriorcurie",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "answerValueNumerical",
          "description": "The value of the answer to a decimal or numberInterval type of question, which is a numeric value.",
          "mappings": [
            "fhir:QuestionnaireResponse.item.answer.valueDecimal"
          ],
          "range": "ValueNumerical",
          "@type": "SlotDefinition"
        },
        {
          "name": "answerValueString",
          "description": "The value of the answer to a choice, openChoice or text type of question, which is a stringValue.",
          "mappings": [
            "fhir:QuestionnaireResponse.item.answer.valueString"
          ],
          "range": "ValueString",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "answerValueDateTime",
          "description": "The value of the answer to a dateTime type of question, which is a datetime value.",
          "mappings": [
            "fhir:QuestionnaireResponse.item.answer.valueDateTime"
          ],
          "range": "ValueDateTime",
          "@type": "SlotDefinition"
        },
        {
          "name": "answerIsEmpty",
          "description": "True if the answer is intentionally empty.",
          "ifabsent": "False",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "answerTimeStamp",
          "description": "The exact date and time when the answer was provided.",
          "range": "datetime",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://faqir.org/datamodel/Answer",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "answerIsEmpty",
                "id_prefixes": [
                  "False"
                ],
                "@type": "SlotDefinition"
              },
              {
                "name": "questionType",
                "equals_string_in": [
                  "decimal",
                  "numberInterval"
                ],
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "answerValueNumerical",
                "comments": [
                  "JsonObj(Validation='numberInterval answerValueNumerical must be between minValue and maxValue')"
                ],
                "required": true,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "If questionType is 'decimal' or 'numberInterval', answerValueNumerical is required.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "answerIsEmpty",
                "id_prefixes": [
                  "False"
                ],
                "@type": "SlotDefinition"
              },
              {
                "name": "questionType",
                "equals_string_in": [
                  "choice",
                  "openChoice",
                  "text"
                ],
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "answerValueString",
                "comments": [
                  "JsonObj(Validation=\"if choice/openChoice, answerValueString must be a list of strings representing the selected options: codes from the Question's ValueCoding.\")"
                ],
                "required": true,
                "multivalued": true,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "If questionType is 'choice', 'openChoice', or 'text', answerValueString is required.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "answerIsEmpty",
                "id_prefixes": [
                  "False"
                ],
                "@type": "SlotDefinition"
              },
              {
                "name": "questionType",
                "equals_string_in": [
                  "dateTime"
                ],
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
