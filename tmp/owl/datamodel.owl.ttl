xsd:integer a owl:Class,
        <https://faqir.org/datamodel/ScoreType> ;
    rdfs:label "numerical_integer" ;
    rdfs:subClassOf <https://faqir.org/datamodel/ScoreType> .

<https://faqir.org/datamodel/ScoreParameterType> a owl:Class,
        linkml:EnumDefinition ;
    owl:unionOf ( xsd:float xsd:dateTime ) ;
    linkml:permissible_values xsd:dateTime,
        xsd:float .

<https://w3id.org/faqir/datamodel/:WeightType> a owl:Class,
        linkml:EnumDefinition ;
    owl:unionOf ( loinc:3141-9 loinc:3142-7 ) ;
    linkml:permissible_values loinc:3141-9,
        loinc:3142-7 .

<https://w3id.org/faqir/datamodel/entities/procedure/Procedure> a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Procedure" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/entities/procedure/procedureId> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/entities/procedure/procedureLabel> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/faqir/datamodel/questionnaire/classes/Questionnaire> ;
            owl:onProperty <https://w3id.org/faqir/datamodel/entities/procedure/procedureHasQuestionnaire> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/entities/procedure/procedureDescription> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/entities/procedure/procedurePerformedByOrg> ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty <https://w3id.org/faqir/datamodel/entities/procedure/procedureLabel> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/entities/procedure/procedureId> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/entities/procedure/procedureHasQuestionnaire> ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty <https://w3id.org/faqir/datamodel/entities/procedure/procedureId> ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty <https://w3id.org/faqir/datamodel/entities/procedure/procedureDescription> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/entities/procedure/procedureLabel> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/faqir/datamodel/entities/organization/Organization> ;
            owl:onProperty <https://w3id.org/faqir/datamodel/entities/procedure/procedurePerformedByOrg> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/entities/procedure/procedureDescription> ] ;
    skos:definition "A clinical or administrative process that uses resources like questionnaires" ;
    skos:exactMatch <https://faqir.org/datamodel/Procedure> ;
    skos:inScheme <https://w3id.org/faqir/datamodel/entities/procedure> ;
    skos:mappingRelation fhir:Procedure .

<https://w3id.org/faqir/datamodel/questionnaire/classes/ScoreParameter> a owl:Class,
