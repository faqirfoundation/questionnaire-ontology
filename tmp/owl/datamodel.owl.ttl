@prefix datamodel: <https://w3id.org/faqir/datamodel/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fhir: <https://www.hl7.org/fhir/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix loinc: <https://loinc.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix questionnaire: <https://w3id.org/faqir/datamodel/questionnaire/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix types: <https://w3id.org/faqir/datamodel/core/types> .
@prefix ucum: <https://unitsofmeasure.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/faqir/datamodel> a owl:Ontology ;
    rdfs:label "datamodel" ;
    dcterms:license "MIT" ;
    dcterms:source <https://faqir.org> ;
    dcterms:title "datamodel" ;
    rdfs:seeAlso <https://faqir.github.io/datamodel> ;
    skos:definition "The datamodel used in faqir vaults." .

<https://w3id.org/faqir/datamodel/core/identifiers/id> a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "id" ;
    rdfs:range linkml:Uriorcurie ;
    skos:definition "Unique identifier for all entities." ;
    skos:inScheme <https://w3id.org/faqir/datamodel/core/identifiers> .

<https://w3id.org/faqir/datamodel/core/types/NumericalParams> a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "NumericalParams" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/numericalPrecision> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( linkml:Integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/numericalPrecision> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/numericalPrecision> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/numericalUnit> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://faqir.org/datamodel/UnitOfMeasure> ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/numericalUnit> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/numericalUnit> ] ;
    skos:definition "Parameters for quantitative values, including unit and precision." ;
    skos:exactMatch <https://faqir.org/datamodel/NumericalParams> ;
    skos:inScheme types: .

<https://w3id.org/faqir/datamodel/core/types/ValueCoding> a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ValueCoding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/display> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/code> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/display> ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/code> ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/display> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/code> ] ;
    skos:definition "A coded value with a unique code for each display text, typically used for standardized questionnaires." ;
    skos:exactMatch <https://faqir.org/datamodel/ValueCoding> ;
    skos:inScheme types: ;
    skos:mappingRelation fhir:Coding .

<https://w3id.org/faqir/datamodel/core/versions/Metadata> a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Metadata" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/versions/lastUpdated> ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Datetime ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/versions/lastUpdated> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/versions/lastUpdated> ] ;
    skos:definition "Base class for metadata tracking (e.g. schema versioning & last updated)." ;
    skos:exactMatch <https://faqir.org/datamodel/Metadata> ;
    skos:inScheme <https://w3id.org/faqir/datamodel/core/versions> .

<https://w3id.org/faqir/datamodel/entities/organization/organizationPerformsProcedure> a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "organizationPerformsProcedure" ;
    rdfs:domain <https://w3id.org/faqir/datamodel/entities/organization/Organization> ;
    rdfs:range <https://w3id.org/faqir/datamodel/entities/procedure/Procedure> ;
    owl:inverseOf <https://w3id.org/faqir/datamodel/entities/procedure/procedurePerformedByOrg> ;
    skos:definition "Procedure managed and performed by this organization." ;
    skos:inScheme <https://w3id.org/faqir/datamodel/entities/organization> .

<https://w3id.org/faqir/datamodel/vault/FullName> a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "FullName" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/first_name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/family_name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/first_name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/family_name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/middle_name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/first_name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/family_name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/middle_name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/middle_name> ] ;
    skos:definition "Structured full name." ;
    skos:inScheme datamodel:vault .

xsd:NMTOKENS a owl:Class,
        <https://faqir.org/datamodel/ScoreType> ;
    rdfs:label "categorical" ;
    rdfs:subClassOf <https://faqir.org/datamodel/ScoreType> .

<https://faqir.org/datamodel/ScoreValueStatus#amended> a owl:Class,
        <https://faqir.org/datamodel/ScoreValueStatus> ;
    rdfs:label "amended" ;
    rdfs:subClassOf <https://faqir.org/datamodel/ScoreValueStatus> .

<https://faqir.org/datamodel/ScoreValueStatus#error> a owl:Class,
        <https://faqir.org/datamodel/ScoreValueStatus> ;
    rdfs:label "error" ;
    rdfs:subClassOf <https://faqir.org/datamodel/ScoreValueStatus> .

<https://faqir.org/datamodel/ScoreValueStatus#estimated> a owl:Class,
        <https://faqir.org/datamodel/ScoreValueStatus> ;
    rdfs:label "estimated" ;
    rdfs:subClassOf <https://faqir.org/datamodel/ScoreValueStatus> .

<https://faqir.org/datamodel/ScoreValueStatus#incomplete> a owl:Class,
        <https://faqir.org/datamodel/ScoreValueStatus> ;
    rdfs:label "incomplete" ;
    rdfs:subClassOf <https://faqir.org/datamodel/ScoreValueStatus> .

<https://faqir.org/datamodel/ScoreValueStatus#pending> a owl:Class,
        <https://faqir.org/datamodel/ScoreValueStatus> ;
    rdfs:label "pending" ;
    rdfs:subClassOf <https://faqir.org/datamodel/ScoreValueStatus> .

<https://faqir.org/datamodel/ScoreValueStatus#valid> a owl:Class,
        <https://faqir.org/datamodel/ScoreValueStatus> ;
    rdfs:label "valid" ;
    rdfs:subClassOf <https://faqir.org/datamodel/ScoreValueStatus> .

<https://faqir.org/datamodel/ScoreValueStatus#warning> a owl:Class,
        <https://faqir.org/datamodel/ScoreValueStatus> ;
    rdfs:label "warning" ;
    rdfs:subClassOf <https://faqir.org/datamodel/ScoreValueStatus> .

loinc:3141-9 a owl:Class,
        <https://w3id.org/faqir/datamodel/:WeightType> ;
    rdfs:label "BODY_WEIGHT_MEASURED" ;
    rdfs:subClassOf <https://w3id.org/faqir/datamodel/:WeightType> .

loinc:3142-7 a owl:Class,
        <https://w3id.org/faqir/datamodel/:WeightType> ;
    rdfs:label "BODY_WEIGHT_STATED" ;
    rdfs:subClassOf <https://w3id.org/faqir/datamodel/:WeightType> .

ucum:cm a owl:Class,
        <https://faqir.org/datamodel/UnitOfMeasure> ;
    rdfs:label "cm" ;
    rdfs:subClassOf <https://faqir.org/datamodel/UnitOfMeasure> .

ucum:g a owl:Class,
        <https://faqir.org/datamodel/UnitOfMeasure> ;
    rdfs:label "g" ;
    rdfs:subClassOf <https://faqir.org/datamodel/UnitOfMeasure> .

ucum:h a owl:Class,
        <https://faqir.org/datamodel/UnitOfMeasure> ;
    rdfs:label "h" ;
    rdfs:subClassOf <https://faqir.org/datamodel/UnitOfMeasure> .

ucum:lb_av a owl:Class,
        <https://faqir.org/datamodel/UnitOfMeasure> ;
    rdfs:label "lb" ;
    rdfs:subClassOf <https://faqir.org/datamodel/UnitOfMeasure> .

ucum:m a owl:Class,
        <https://faqir.org/datamodel/UnitOfMeasure> ;
    rdfs:label "m" ;
    rdfs:subClassOf <https://faqir.org/datamodel/UnitOfMeasure> .

ucum:min a owl:Class,
        <https://faqir.org/datamodel/UnitOfMeasure> ;
    rdfs:label "min" ;
    rdfs:subClassOf <https://faqir.org/datamodel/UnitOfMeasure> .

<https://w3id.org/faqir/datamodel/:MassUnit> a owl:Class,
        linkml:EnumDefinition ;
    linkml:permissible_values ucum:kg .

<https://w3id.org/faqir/datamodel/core/types/IntervalParams> a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "IntervalParams" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/maxLabel> ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Float ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/maxValue> ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Float ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/minValue> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/minValue> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/minValue> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/maxLabel> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/maxValue> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/minLabel> ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/minLabel> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/maxValue> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/minLabel> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/maxLabel> ] ;
    skos:definition "Parameters for interval values, including minimum and maximum values." ;
    skos:exactMatch <https://faqir.org/datamodel/IntervalParams> ;
    skos:inScheme types: .

<https://w3id.org/faqir/datamodel/core/types/ValueDateTime> a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ValueDateTime" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom linkml:Datetime ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/dateTimeValue> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/dateTimeValue> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/dateTimeValue> ] ;
    skos:definition "A date and time value, typically in ISO 8601 format." ;
    skos:exactMatch <https://faqir.org/datamodel/ValueDateTime> ;
    skos:inScheme types: ;
    skos:mappingRelation xsd:dateTime .

<https://w3id.org/faqir/datamodel/core/types/ValueString> a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ValueString" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/stringValue> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/stringValue> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/stringValue> ] ;
    skos:definition "A string value, typically used for text or identifiers." ;
    skos:exactMatch <https://faqir.org/datamodel/ValueString> ;
    skos:inScheme types: ;
    skos:mappingRelation xsd:string .

<https://w3id.org/faqir/datamodel/questionnaire/classes/answerValueString> a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "answerValueString" ;
    skos:definition "The value of the answer to a choice, openChoice or text type of question, which is a stringValue." ;
    skos:inScheme questionnaire:classes ;
    skos:mappingRelation fhir:QuestionnaireResponse.item.answer.valueString .

<https://w3id.org/faqir/datamodel/questionnaire/classes/questionCodingParams> a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "questionCodingParams" ;
    skos:definition "Code and Display of each option offered as answer to the choice or open-choice question." ;
    skos:inScheme questionnaire:classes .

<https://w3id.org/faqir/datamodel/questionnaire/classes/scoreDefinitionCategories> a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "scoreDefinitionCategories" ;
    skos:definition "Categories for categorical scores." ;
    skos:inScheme questionnaire:classes .

<https://w3id.org/faqir/datamodel/vault/Weight> a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Weight" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/faqir/datamodel/:WeightType> ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/weightType> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/weightType> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/weightType> ],
        <https://w3id.org/faqir/datamodel/core/types/ValueNumerical> ;
    skos:definition "Weight." ;
    skos:inScheme datamodel:vault .

fhir:choice a owl:Class,
        <https://faqir.org/datamodel/QuestionType> ;
    rdfs:label "choice" ;
    rdfs:subClassOf <https://faqir.org/datamodel/QuestionType> .

fhir:dateTime a owl:Class,
        <https://faqir.org/datamodel/QuestionType> ;
    rdfs:label "dateTime" ;
    rdfs:subClassOf <https://faqir.org/datamodel/QuestionType> .

fhir:decimal a owl:Class,
        <https://faqir.org/datamodel/QuestionType> ;
    rdfs:label "decimal" ;
    rdfs:subClassOf <https://faqir.org/datamodel/QuestionType> .

fhir:number a owl:Class,
        <https://faqir.org/datamodel/QuestionType> ;
    rdfs:label "numberInterval" ;
    rdfs:subClassOf <https://faqir.org/datamodel/QuestionType> .

fhir:open-choice a owl:Class,
        <https://faqir.org/datamodel/QuestionType> ;
    rdfs:label "openChoice" ;
    rdfs:subClassOf <https://faqir.org/datamodel/QuestionType> .

<https://www.hl7.org/fhir/organization-type#bus> a owl:Class,
        <https://faqir.org/datamodel/OrganizationType> ;
    rdfs:label "serviceProvider" ;
    rdfs:subClassOf <https://faqir.org/datamodel/OrganizationType> .

<https://www.hl7.org/fhir/organization-type#edu> a owl:Class,
        <https://faqir.org/datamodel/OrganizationType> ;
    rdfs:label "research" ;
    rdfs:subClassOf <https://faqir.org/datamodel/OrganizationType> .

<https://www.hl7.org/fhir/organization-type#gov> a owl:Class,
        <https://faqir.org/datamodel/OrganizationType> ;
    rdfs:label "government" ;
    rdfs:subClassOf <https://faqir.org/datamodel/OrganizationType> .

<https://www.hl7.org/fhir/organization-type#ind> a owl:Class,
        <https://faqir.org/datamodel/OrganizationType> ;
    rdfs:label "professional" ;
    rdfs:subClassOf <https://faqir.org/datamodel/OrganizationType> .

<https://www.hl7.org/fhir/organization-type#prov> a owl:Class,
        <https://faqir.org/datamodel/OrganizationType> ;
    rdfs:label "hospital" ;
    rdfs:subClassOf <https://faqir.org/datamodel/OrganizationType> .

fhir:questionnaire-answers-status-amended a owl:Class,
        <https://faqir.org/datamodel/QuestionnaireResponseStatus> ;
    rdfs:label "amended" ;
    rdfs:subClassOf <https://faqir.org/datamodel/QuestionnaireResponseStatus> .

fhir:questionnaire-answers-status-completed a owl:Class,
        <https://faqir.org/datamodel/QuestionnaireResponseStatus> ;
    rdfs:label "completed" ;
