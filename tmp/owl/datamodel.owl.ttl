        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/questionnaire/classes/scoreParameterId> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/questionnaire/relationship_slots/scoreParameterPartOfScoreDefinition> ],
        [ a owl:Restriction ;
