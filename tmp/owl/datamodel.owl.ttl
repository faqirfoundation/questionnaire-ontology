        <https://faqir.org/datamodel/QuestionnaireStatus> ;
    rdfs:label "unknown" ;
    rdfs:subClassOf <https://faqir.org/datamodel/QuestionnaireStatus> .

fhir:string a owl:Class,
        <https://faqir.org/datamodel/QuestionType> ;
    rdfs:label "text" ;
    rdfs:subClassOf <https://faqir.org/datamodel/QuestionType> .

xsd:dateTime a owl:Class,
        <https://faqir.org/datamodel/ScoreParameterType> ;
    rdfs:label "dateTime" ;
    rdfs:subClassOf <https://faqir.org/datamodel/ScoreParameterType> .

ucum:kg a owl:Class,
        <https://faqir.org/datamodel/UnitOfMeasure>,
        <https://w3id.org/faqir/datamodel/:MassUnit> ;
    rdfs:label "kg" ;
    rdfs:subClassOf <https://faqir.org/datamodel/UnitOfMeasure>,
        <https://w3id.org/faqir/datamodel/:MassUnit> .

<https://w3id.org/faqir/datamodel/core/types/code> a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "code" ;
    skos:definition "The code representing the value (e.g. code '1' for display 'Yes')." ;
    skos:inScheme types: .

<https://w3id.org/faqir/datamodel/core/types/dateTimeValue> a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dateTimeValue" ;
    skos:definition "The date and time value in ISO 8601 format." ;
    skos:inScheme types: .

<https://w3id.org/faqir/datamodel/core/types/display> a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "display" ;
    skos:definition "The human-readable display text for the code (e.g. code '1' for display 'Yes')." ;
    skos:inScheme types: .

<https://w3id.org/faqir/datamodel/core/types/maxLabel> a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "maxLabel" ;
    skos:definition "The label for the maximum value of the interval." ;
    skos:inScheme types: .

<https://w3id.org/faqir/datamodel/core/types/maxValue> a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "maxValue" ;
    skos:definition "The maximum value of the interval." ;
