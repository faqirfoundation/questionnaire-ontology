fhir:questionnaire-answers-status-stopped a owl:Class,
        <https://faqir.org/datamodel/QuestionnaireResponseStatus> ;
    rdfs:label "stopped" ;
    rdfs:subClassOf <https://faqir.org/datamodel/QuestionnaireResponseStatus> .

fhir:resource-status-active a owl:Class,
        <https://faqir.org/datamodel/QuestionnaireStatus> ;
    rdfs:label "active" ;
    rdfs:subClassOf <https://faqir.org/datamodel/QuestionnaireStatus> .

fhir:resource-status-draft a owl:Class,
        <https://faqir.org/datamodel/QuestionnaireStatus> ;
    rdfs:label "draft" ;
    rdfs:subClassOf <https://faqir.org/datamodel/QuestionnaireStatus> .

fhir:resource-status-retired a owl:Class,
        <https://faqir.org/datamodel/QuestionnaireStatus> ;
    rdfs:label "retired" ;
    rdfs:subClassOf <https://faqir.org/datamodel/QuestionnaireStatus> .

