@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fhir: <http://hl7.org/fhir/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix phro: <https://ns.faqir.org/phr-o#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qo: <https://ns.faqir.org/q-o#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s4ehaw: <https://saref.etsi.org/saref4ehaw/> .
@prefix saref: <https://saref.etsi.org/core/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sulo: <https://aidava-dev.github.io/sulo/ontospy/index.html> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix ucum: <https://unitsofmeasure.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fhir:Procedure a sh:NodeShape ;
    sh:closed true ;
    sh:description "An action that is being or was performed on an individual or entity" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class saref:PropertyValue ;
            sh:description "A code specifying the state of the observation/procedure/questionnaire... Generally, this will be the in-progress or completed state." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fhir:resource-status ],
        [ sh:class owl:Thing ;
            sh:description "A related resource that is included either physically or logically in the described resource." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path dcterms:hasPart ],
        [ sh:class prov:Entity ;
            sh:description "A primary source for a topic refers to something produced by some agent with direct experience and knowledge about the topic, at the time of the topic's study, without benefit from hindsight. Because of the directness of primary sources, they 'speak for themselves' in ways that cannot be captured through the filter of secondary sources. As such, it is important for secondary sources to reference those primary sources from which they were derived, so that their reliability can be investigated. A primary source relation is a particular case of derivation of secondary materials from their primary sources. It is recognized that the determination of primary sources can be up to interpretation, and should be done according to conventions accepted within the application's domain." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path prov:hadPrimarySource ],
        [ sh:datatype xsd:string ;
            sh:description "An owl:versionInfo statement generally has as its object a string giving information about this version, for example RCS/CVS keywords. This statement does not contribute to the logical meaning of the ontology other than that given by the RDF(S) model theory." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path owl:versionInfo ],
        [ sh:class sulo:Process ;
            sh:description "Generation is the completion of production of a new entity by an activity. This entity did not exist before generation and becomes available for usage after this generation." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class owl:Thing ;
            sh:description "A related resource in which the described resource is physically or logically included." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path dcterms:isPartOf ],
        [ sh:datatype xsd:string ;
            sh:description "A textual comment helps clarify the meaning of RDF classes and properties. Such in-line documentation complements the use of both formal techniques (Ontology and rule languages) and informal (prose documentation, examples, test cases). A variety of documentation forms can be combined to indicate the intended meaning of the classes and properties described in an RDF vocabulary. Since RDF vocabularies are expressed as RDF graphs, vocabularies defined in other namespaces may be used to provide richer documentation." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path rdfs:comment ],
        [ sh:datatype xsd:string ;
            sh:description "human-readable version of a resource's name. Multilingual labels are supported using the language tagging facility of RDF literals." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path rdfs:label ],
        [ sh:class saref:PropertyValue ;
            sh:description "Links a feature kind, a feature of interest, or a property of interest, to a property value." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path saref:hasPropertyValue ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The time at which an entity was completely created and is available for use." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path prov:generatedAtTime ],
        [ sh:datatype xsd:anyURI ;
            sh:description "The attribute prov:type provides further typing information for any construct with an optional set of attribute-value pairs." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path prov:type ],
        [ sh:class saref:Property ;
            sh:description "Links a feature kind or a feature of interest to one of its properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path saref:hasProperty ],
        [ sh:class foaf:Agent ;
            sh:description "An entity responsible for making the resource." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path dcterms:creator ] ;
    sh:targetClass fhir:Procedure .

prov:Attribution a sh:NodeShape ;
    sh:closed true ;
    sh:description "An instance of prov:Attribution provides additional descriptions about the binary prov:wasAttributedTo relation from an prov:Entity to some prov:Agent that had some responsible for it. For example, :cake prov:wasAttributedTo :baker; prov:qualifiedAttribution [ a prov:Attribution; prov:entity :baker; :foo :bar ]." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass prov:Attribution .

qo:QuestionnaireResponse a sh:NodeShape ;
    sh:closed true ;
    sh:description "A response to a questionnaire (collection of answers)." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class sulo:Process ;
            sh:description "Generation is the completion of production of a new entity by an activity. This entity did not exist before generation and becomes available for usage after this generation." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:string ;
            sh:description "An owl:versionInfo statement generally has as its object a string giving information about this version, for example RCS/CVS keywords. This statement does not contribute to the logical meaning of the ontology other than that given by the RDF(S) model theory." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path owl:versionInfo ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The date and time when the questionnaire response was last updated." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:modified ],
        [ sh:class qo:Questionnaire ;
            sh:description "The Questionnaire that this QuestionnaireResponse is for." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path qo:responds ],
        [ sh:class sulo:Process ;
            sh:description "Process this questionnaire response instance is part of." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path dcterms:isPartOf ],
        [ sh:datatype xsd:string ;
            sh:description "human-readable version of a resource's name. Multilingual labels are supported using the language tagging facility of RDF literals." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path rdfs:label ],
        [ sh:class qo:QuestionnaireResponseStatus ;
            sh:description "A code specifying the state of the observation/procedure/questionnaire... Generally, this will be the in-progress or completed state." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fhir:resource-status ],
        [ sh:datatype xsd:string ;
            sh:description "A textual comment helps clarify the meaning of RDF classes and properties. Such in-line documentation complements the use of both formal techniques (Ontology and rule languages) and informal (prose documentation, examples, test cases). A variety of documentation forms can be combined to indicate the intended meaning of the classes and properties described in an RDF vocabulary. Since RDF vocabularies are expressed as RDF graphs, vocabularies defined in other namespaces may be used to provide richer documentation." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path rdfs:comment ],
        [ sh:class owl:Thing ;
            sh:description "A related resource that is included either physically or logically in the described resource." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path dcterms:hasPart ],
        [ sh:class saref:Property ;
            sh:description "Links a feature kind or a feature of interest to one of its properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path saref:hasProperty ],
        [ sh:class prov:Entity ;
            sh:description "A primary source for a topic refers to something produced by some agent with direct experience and knowledge about the topic, at the time of the topic's study, without benefit from hindsight. Because of the directness of primary sources, they 'speak for themselves' in ways that cannot be captured through the filter of secondary sources. As such, it is important for secondary sources to reference those primary sources from which they were derived, so that their reliability can be investigated. A primary source relation is a particular case of derivation of secondary materials from their primary sources. It is recognized that the determination of primary sources can be up to interpretation, and should be done according to conventions accepted within the application's domain." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path prov:hadPrimarySource ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The time at which an entity was completely created and is available for use." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path prov:generatedAtTime ],
        [ sh:class foaf:Person ;
            sh:description "Attribution is the ascribing of an entity to an agent." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The date and time when the questionnaire response was created (when the questionnaire starts to be answered, not when it's finished)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:created ],
        [ sh:class saref:PropertyValue ;
            sh:description "Links a feature kind, a feature of interest, or a property of interest, to a property value." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path saref:hasPropertyValue ],
        [ sh:datatype xsd:anyURI ;
            sh:description "The attribute prov:type provides further typing information for any construct with an optional set of attribute-value pairs." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path prov:type ],
        [ sh:class foaf:Agent ;
            sh:description "An entity responsible for making the resource." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path dcterms:creator ],
        [ sh:class qo:Answer ;
            sh:description "The Answer that is part of this QuestionnaireResponse." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path qo:hasAnswer ] ;
    sh:targetClass qo:QuestionnaireResponse .

s4ehaw:activity a sh:NodeShape ;
    sh:closed true ;
    sh:description "The activity of a patient/user, i.e. daily and nocturnal activities." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class sulo:Process ;
            sh:description "Generation is the completion of production of a new entity by an activity. This entity did not exist before generation and becomes available for usage after this generation." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class saref:PropertyValue ;
            sh:description "Links a feature kind, a feature of interest, or a property of interest, to a property value." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path saref:hasPropertyValue ],
        [ sh:class owl:Thing ;
            sh:description "A related resource in which the described resource is physically or logically included." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path dcterms:isPartOf ],
        [ sh:datatype xsd:string ;
            sh:description "A textual comment helps clarify the meaning of RDF classes and properties. Such in-line documentation complements the use of both formal techniques (Ontology and rule languages) and informal (prose documentation, examples, test cases). A variety of documentation forms can be combined to indicate the intended meaning of the classes and properties described in an RDF vocabulary. Since RDF vocabularies are expressed as RDF graphs, vocabularies defined in other namespaces may be used to provide richer documentation." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path rdfs:comment ],
        [ sh:class foaf:Agent ;
            sh:description "An entity responsible for making the resource." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path dcterms:creator ],
        [ sh:class prov:Entity ;
            sh:description "A primary source for a topic refers to something produced by some agent with direct experience and knowledge about the topic, at the time of the topic's study, without benefit from hindsight. Because of the directness of primary sources, they 'speak for themselves' in ways that cannot be captured through the filter of secondary sources. As such, it is important for secondary sources to reference those primary sources from which they were derived, so that their reliability can be investigated. A primary source relation is a particular case of derivation of secondary materials from their primary sources. It is recognized that the determination of primary sources can be up to interpretation, and should be done according to conventions accepted within the application's domain." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path prov:hadPrimarySource ],
        [ sh:datatype xsd:string ;
            sh:description "human-readable version of a resource's name. Multilingual labels are supported using the language tagging facility of RDF literals." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The time at which an entity was completely created and is available for use." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path prov:generatedAtTime ],
        [ sh:class saref:PropertyValue ;
            sh:description "A code specifying the state of the observation/procedure/questionnaire... Generally, this will be the in-progress or completed state." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fhir:resource-status ],
        [ sh:datatype xsd:anyURI ;
            sh:description "The attribute prov:type provides further typing information for any construct with an optional set of attribute-value pairs." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path prov:type ],
        [ sh:class owl:Thing ;
            sh:description "A related resource that is included either physically or logically in the described resource." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path dcterms:hasPart ],
        [ sh:datatype xsd:string ;
            sh:description "An owl:versionInfo statement generally has as its object a string giving information about this version, for example RCS/CVS keywords. This statement does not contribute to the logical meaning of the ontology other than that given by the RDF(S) model theory." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path owl:versionInfo ],
        [ sh:class saref:Property ;
            sh:description "Links a feature kind or a feature of interest to one of its properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path saref:hasProperty ] ;
    sh:targetClass s4ehaw:activity .

time:Duration a sh:NodeShape ;
    sh:closed true ;
    sh:description "Duration of a temporal extent expressed as a decimal number scaled by a temporal unit" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:description "A relationship identifying the unit of measure used for a certain entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path saref:isMeasuredIn ;
            sh:pattern "^ucum" ],
        [ sh:description "Value of a property value expressed as an RDF literal. Note that, even if decimal values are expected, values could use other datatypes." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:integer ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:double ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:decimal ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:date ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:dateTime ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:anyURI ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 0 ;
            sh:path saref:hasValue ] ;
    sh:targetClass time:Duration .

foaf:Person a sh:NodeShape ;
    sh:closed true ;
    sh:description "A person." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class sulo:Process ;
            sh:description "Generation is the completion of production of a new entity by an activity. This entity did not exist before generation and becomes available for usage after this generation." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class prov:Entity ;
            sh:description "A primary source for a topic refers to something produced by some agent with direct experience and knowledge about the topic, at the time of the topic's study, without benefit from hindsight. Because of the directness of primary sources, they 'speak for themselves' in ways that cannot be captured through the filter of secondary sources. As such, it is important for secondary sources to reference those primary sources from which they were derived, so that their reliability can be investigated. A primary source relation is a particular case of derivation of secondary materials from their primary sources. It is recognized that the determination of primary sources can be up to interpretation, and should be done according to conventions accepted within the application's domain." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path prov:hadPrimarySource ],
        [ sh:class saref:PropertyValue ;
            sh:description "A code specifying the state of the observation/procedure/questionnaire... Generally, this will be the in-progress or completed state." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fhir:resource-status ],
        [ sh:datatype xsd:anyURI ;
            sh:description "The attribute prov:type provides further typing information for any construct with an optional set of attribute-value pairs." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path prov:type ],
        [ sh:class owl:Thing ;
            sh:description "A related resource that is included either physically or logically in the described resource." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path dcterms:hasPart ],
        [ sh:datatype xsd:string ;
            sh:description "A textual comment helps clarify the meaning of RDF classes and properties. Such in-line documentation complements the use of both formal techniques (Ontology and rule languages) and informal (prose documentation, examples, test cases). A variety of documentation forms can be combined to indicate the intended meaning of the classes and properties described in an RDF vocabulary. Since RDF vocabularies are expressed as RDF graphs, vocabularies defined in other namespaces may be used to provide richer documentation." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path rdfs:comment ],
        [ sh:class foaf:Agent ;
            sh:description "An entity responsible for making the resource." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path dcterms:creator ],
        [ sh:datatype xsd:string ;
            sh:description "An owl:versionInfo statement generally has as its object a string giving information about this version, for example RCS/CVS keywords. This statement does not contribute to the logical meaning of the ontology other than that given by the RDF(S) model theory." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path owl:versionInfo ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The time at which an entity was completely created and is available for use." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path prov:generatedAtTime ],
        [ sh:class saref:PropertyValue ;
            sh:description "Links a feature kind, a feature of interest, or a property of interest, to a property value." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path saref:hasPropertyValue ],
        [ sh:class owl:Thing ;
            sh:description "A related resource in which the described resource is physically or logically included." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path dcterms:isPartOf ],
        [ sh:class saref:Property ;
            sh:description "Links a feature kind or a feature of interest to one of its properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path saref:hasProperty ],
        [ sh:datatype xsd:string ;
            sh:description "human-readable version of a resource's name. Multilingual labels are supported using the language tagging facility of RDF literals." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path rdfs:label ] ;
    sh:targetClass foaf:Person .

phro:IntervalParams a sh:NodeShape ;
    sh:closed true ;
    sh:description "Parameters for interval values, including minimum and maximum values." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The label for the minimum value of the interval." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path phro:minLabel ],
        [ sh:datatype xsd:float ;
            sh:description "The minimum value of the interval." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path phro:minValue ],
        [ sh:datatype xsd:string ;
            sh:description "The label for the maximum value of the interval." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path phro:maxLabel ],
        [ sh:datatype xsd:float ;
            sh:description "The maximum value of the interval." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path phro:maxValue ] ;
    sh:targetClass phro:IntervalParams .

phro:NumericalParams a sh:NodeShape ;
    sh:closed true ;
    sh:description "Parameters for quantitative values, including unit and precision." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:description "The unit of measure for the quantitative value, from UCUM standard." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path ucum:units ;
            sh:pattern "^ucum:" ],
        [ sh:datatype xsd:integer ;
            sh:description "The precision of the quantitative value, e.g. number of decimal places." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path phro:precision ] ;
    sh:targetClass phro:NumericalParams .

qo:Answer a sh:NodeShape ;
    sh:closed true ;
    sh:description "Answer in the questionnaire response." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class foaf:Agent ;
            sh:description "An entity responsible for making the resource." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path dcterms:creator ],
        [ sh:datatype xsd:boolean ;
            sh:description "True if the answer is intentionally left empty." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path qo:isEmpty ],
        [ sh:class saref:Property ;
            sh:description "Links a feature kind or a feature of interest to one of its properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path saref:hasProperty ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The time at which an entity was completely created and is available for use." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path prov:generatedAtTime ],
        [ sh:class foaf:Agent ;
            sh:description "Attribution is the ascribing of an entity to an agent." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class owl:Thing ;
            sh:description "A related resource that is included either physically or logically in the described resource." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path dcterms:hasPart ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The date and time when the entity was last updated." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:modified ],
        [ sh:class sulo:Process ;
            sh:description "Generation is the completion of production of a new entity by an activity. This entity did not exist before generation and becomes available for usage after this generation." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class qo:Question ;
            sh:description "The Question that this Answer is for." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path qo:toQuestion ],
        [ sh:datatype xsd:string ;
            sh:description "human-readable version of a resource's name. Multilingual labels are supported using the language tagging facility of RDF literals." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path rdfs:label ],
        [ sh:class owl:Thing ;
            sh:description "A related resource in which the described resource is physically or logically included." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path dcterms:isPartOf ],
        [ sh:description "The value of the answer to: a decimal or numberInterval type of question, which is a numeric value; a choice, openChoice or text type of question, which is a stringValue; dateTime type of question, which is a datetime value." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:dateTime ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path qo:answerValue ],
        [ sh:datatype xsd:string ;
            sh:description "An owl:versionInfo statement generally has as its object a string giving information about this version, for example RCS/CVS keywords. This statement does not contribute to the logical meaning of the ontology other than that given by the RDF(S) model theory." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path owl:versionInfo ],
        [ sh:class saref:PropertyValue ;
            sh:description "Links a feature kind, a feature of interest, or a property of interest, to a property value." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path saref:hasPropertyValue ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The date and time when the entity was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:created ],
        [ sh:class prov:Entity ;
            sh:description "A primary source for a topic refers to something produced by some agent with direct experience and knowledge about the topic, at the time of the topic's study, without benefit from hindsight. Because of the directness of primary sources, they 'speak for themselves' in ways that cannot be captured through the filter of secondary sources. As such, it is important for secondary sources to reference those primary sources from which they were derived, so that their reliability can be investigated. A primary source relation is a particular case of derivation of secondary materials from their primary sources. It is recognized that the determination of primary sources can be up to interpretation, and should be done according to conventions accepted within the application's domain." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path prov:hadPrimarySource ],
        [ sh:datatype xsd:string ;
            sh:description "A textual comment helps clarify the meaning of RDF classes and properties. Such in-line documentation complements the use of both formal techniques (Ontology and rule languages) and informal (prose documentation, examples, test cases). A variety of documentation forms can be combined to indicate the intended meaning of the classes and properties described in an RDF vocabulary. Since RDF vocabularies are expressed as RDF graphs, vocabularies defined in other namespaces may be used to provide richer documentation." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path rdfs:comment ],
        [ sh:class saref:PropertyValue ;
            sh:description "A code specifying the state of the observation/procedure/questionnaire... Generally, this will be the in-progress or completed state." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fhir:resource-status ],
        [ sh:datatype xsd:anyURI ;
            sh:description "The attribute prov:type provides further typing information for any construct with an optional set of attribute-value pairs." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path prov:type ] ;
    sh:targetClass qo:Answer .

