            sh:order 10 ;
            sh:path rdfs:comment ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The time at which an entity was completely created and is available for use." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path prov:generatedAtTime ] ;
    sh:targetClass foaf:Agent .

owl:Thing a sh:NodeShape ;
    sh:closed true ;
    sh:description "This defines IOT as the set of OWL individuals." ;
    sh:ignoredProperties ( prov:endedAtTime qo:multivalued fhir:valueRange saref:hasPropertyValue rdf:type prov:type dcterms:hasPart qo:responds dcterms:isPartOf qo:hasAnswer fhir:valueCodeableConcept prov:generatedAtTime qo:section qo:required qo:toQuestion fhir:Observation.referenceRange qo:hasOrderedQuestion fhir:valuePeriod saref:isValueOfProperty qo:temporalValidity saref:hasProperty qo:numericalParams dcterms:modified fhir:valueAttachment qo:tag prov:wasAttributedTo qo:codingOrdinal qo:hasOrderedSection qo:order qo:answerValue qo:question saref:hasValue dcterms:created qo:conditionalValidity qo:intervalParams qo:codingParams fhir:resource-status qo:isEmpty fhir:valueReference qo:hardValidity prov:atTime prov:startedAtTime fhir:valueRatio dcterms:creator ) ;
    sh:property [ sh:class prov:Entity ;
            sh:description "A primary source for a topic refers to something produced by some agent with direct experience and knowledge about the topic, at the time of the topic's study, without benefit from hindsight. Because of the directness of primary sources, they 'speak for themselves' in ways that cannot be captured through the filter of secondary sources. As such, it is important for secondary sources to reference those primary sources from which they were derived, so that their reliability can be investigated. A primary source relation is a particular case of derivation of secondary materials from their primary sources. It is recognized that the determination of primary sources can be up to interpretation, and should be done according to conventions accepted within the application's domain." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path prov:hadPrimarySource ],
        [ sh:datatype xsd:string ;
            sh:description "human-readable version of a resource's name. Multilingual labels are supported using the language tagging facility of RDF literals." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:class sulo:Process ;
            sh:description "Generation is the completion of production of a new entity by an activity. This entity did not exist before generation and becomes available for usage after this generation." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:string ;
            sh:description "A textual comment helps clarify the meaning of RDF classes and properties. Such in-line documentation complements the use of both formal techniques (Ontology and rule languages) and informal (prose documentation, examples, test cases). A variety of documentation forms can be combined to indicate the intended meaning of the classes and properties described in an RDF vocabulary. Since RDF vocabularies are expressed as RDF graphs, vocabularies defined in other namespaces may be used to provide richer documentation." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rdfs:comment ],
        [ sh:datatype xsd:string ;
            sh:description "An owl:versionInfo statement generally has as its object a string giving information about this version, for example RCS/CVS keywords. This statement does not contribute to the logical meaning of the ontology other than that given by the RDF(S) model theory." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path owl:versionInfo ] ;
    sh:targetClass owl:Thing .

saref:PropertyValue a sh:NodeShape ;
    sh:closed true ;
    sh:description "Describes the value for a property. The property value is optionally linked to its value expressed as an RDF literal (DP saref:hasValue), optionally to the unit of measurement (OP saref:isMeasuredIn), and optionally to the properties or properties of interest it is a value of (OP saref:isValueOfProperty)." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fhir:Coding ;
            sh:description "A CodeableConcept represents a value that is usually supplied by providing a reference to one or more terminologies or ontologies but may also be defined by the provision of text. This is a common pattern in healthcare data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fhir:valueCodeableConcept ],
        [ sh:datatype xsd:anyURI ;
            sh:description "The Reference type contains at least one of a reference (literal reference), an identifier (logical reference), and a display (text description of target). In addition, it may contain a target type." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fhir:valueReference ],
        [ sh:class sulo:Process ;
            sh:description "Generation is the completion of production of a new entity by an activity. This entity did not exist before generation and becomes available for usage after this generation." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 24 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class foaf:Agent ;
            sh:description "An entity responsible for making the resource." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path dcterms:creator ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The time at which an entity was completely created and is available for use." ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path prov:generatedAtTime ],
        [ sh:datatype xsd:string ;
            sh:description "A textual comment helps clarify the meaning of RDF classes and properties. Such in-line documentation complements the use of both formal techniques (Ontology and rule languages) and informal (prose documentation, examples, test cases). A variety of documentation forms can be combined to indicate the intended meaning of the classes and properties described in an RDF vocabulary. Since RDF vocabularies are expressed as RDF graphs, vocabularies defined in other namespaces may be used to provide richer documentation." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path rdfs:comment ],
        [ sh:datatype xsd:string ;
            sh:description "human-readable version of a resource's name. Multilingual labels are supported using the language tagging facility of RDF literals." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path rdfs:label ],
        [ sh:class saref:Property ;
            sh:description "Links a property value to the property or property of interest it is a value of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path saref:isValueOfProperty ],
        [ sh:class saref:PropertyValue ;
            sh:description "A code specifying the state of the observation/procedure/questionnaire... Generally, this will be the in-progress or completed state." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fhir:resource-status ],
        [ sh:class owl:Thing ;
            sh:description "A related resource that is included either physically or logically in the described resource." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path dcterms:hasPart ],
        [ sh:class fhir:Ratio ;
            sh:description "A relationship between two Quantity values expressed as a numerator and a denominator. The Ratio datatype should only be used to express a relationship of two numbers if the relationship cannot be suitably expressed using a Quantity and a common unit. Where the denominator value is known to be fixed to '1', Quantity should be used instead of Ratio." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fhir:valueRatio ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The date and time when the entity was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dcterms:created ],
        [ sh:class saref:Property ;
            sh:description "Links a feature kind or a feature of interest to one of its properties." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path saref:hasProperty ],
        [ sh:datatype xsd:string ;
            sh:description "An owl:versionInfo statement generally has as its object a string giving information about this version, for example RCS/CVS keywords. This statement does not contribute to the logical meaning of the ontology other than that given by the RDF(S) model theory." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path owl:versionInfo ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The time at which an InstantaneousEvent occurred." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path prov:atTime ],
        [ sh:description "Value of a property value expressed as an RDF literal. Note that, even if decimal values are expected, values could use other datatypes." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:integer ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:double ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:decimal ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:date ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:dateTime ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:anyURI ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path saref:hasValue ],
        [ sh:datatype xsd:anyURI ;
            sh:description "This type is for containing or referencing attachments - additional data content defined in other formats. The most common use of this type is to include images or reports in some report format such as PDF. However, it can be used for any data that has a MIME type." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fhir:valueAttachment ],
        [ sh:datatype xsd:anyURI ;
            sh:description "The attribute prov:type provides further typing information for any construct with an optional set of attribute-value pairs." ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path prov:type ],
        [ sh:class prov:Entity ;
            sh:description "A primary source for a topic refers to something produced by some agent with direct experience and knowledge about the topic, at the time of the topic's study, without benefit from hindsight. Because of the directness of primary sources, they 'speak for themselves' in ways that cannot be captured through the filter of secondary sources. As such, it is important for secondary sources to reference those primary sources from which they were derived, so that their reliability can be investigated. A primary source relation is a particular case of derivation of secondary materials from their primary sources. It is recognized that the determination of primary sources can be up to interpretation, and should be done according to conventions accepted within the application's domain." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path prov:hadPrimarySource ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The date and time when the entity was last updated." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dcterms:modified ],
        [ sh:class fhir:Observation.referenceRange ;
            sh:description "A set of ordered Quantity values defined by a low and high limit." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fhir:valueRange ],
        [ sh:class owl:Thing ;
            sh:description "A related resource in which the described resource is physically or logically included." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path dcterms:isPartOf ],
        [ sh:class time:Interval ;
            sh:description "A time period defined by a start and end date/time. A period specifies a range of times. The context of use will specify whether the entire range applies (e.g. 'the patient was an inpatient of the hospital for this time range') or one value from the period applies (e.g. 'give to the patient between 2 and 4 pm on 24-Jun 2013')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fhir:valuePeriod ],
        [ sh:class foaf:Agent ;
            sh:description "Attribution is the ascribing of an entity to an agent." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class saref:PropertyValue ;
            sh:description "Links a feature kind, a feature of interest, or a property of interest, to a property value." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path saref:hasPropertyValue ] ;
    sh:targetClass saref:PropertyValue .


