fhir:Coding a sh:NodeShape ;
    sh:closed true ;
    sh:description "A coded value with a unique code for each display text, typically used for standardized questionnaires." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The human-readable display text for the code (e.g. code '1' for value 'Yes')." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fhir:display ],
        [ sh:datatype xsd:string ;
            sh:description "The code representing the value (e.g. code '1' for value 'Yes')." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fhir:code ] ;
    sh:targetClass fhir:Coding .

fhir:datatypes.Quantity a sh:NodeShape ;
    sh:closed true ;
    sh:description "A measured amount (or an amount that can potentially be measured)." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Value of a property value expressed as an RDF literal. Note that, even if decimal values are expected, values could use other datatypes." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:integer ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:float ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:double ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:decimal ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:date ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:dateTime ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:anyURI ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 1 ;
            sh:path saref:hasValue ],
        [ sh:datatype xsd:anyURI ;
            sh:description "A relationship identifying the unit of measure used for a certain entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path saref:isMeasuredIn ;
            sh:pattern "^ucum" ] ;
    sh:targetClass fhir:datatypes.Quantity .

fhir:Observation.referenceRange a sh:NodeShape ;
    sh:closed true ;
    sh:description "Guidance on how to interpret the value by comparison to a normal or recommended range. Multiple reference ranges are interpreted as an 'OR'. In other words, to represent two distinct target populations, two referenceRange elements would be used." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fhir:datatypes.Quantity ;
            sh:description "Low range, if relevant." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path phro:lowRange ],
        [ sh:class fhir:datatypes.Quantity ;
            sh:description "High range, if relevant." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path phro:highRange ],
        [ sh:class fhir:datatypes.Quantity ;
            sh:description "Normal value, if relevant." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path phro:normalValue ] ;
    sh:targetClass fhir:Observation.referenceRange .

