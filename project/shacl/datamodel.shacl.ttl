@prefix datamodel: <https://w3id.org/faqir/datamodel/> .
@prefix loinc: <https://loinc.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

datamodel:vault a sh:NodeShape ;
    sh:closed true ;
    sh:description "The FAQIR healthdata vault" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class datamodel:WeightC ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path datamodel:weight ],
        [ sh:datatype xsd:date ;
            sh:description "The date of birth" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path datamodel:birthdate ],
        [ sh:datatype xsd:anyURI ;
            sh:description "The unique identifier for a vault." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path datamodel:id ;
            sh:pattern "^https://pods.faqir.org/[^\\s]++$" ],
        [ sh:class datamodel:FullName ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path datamodel:full_name ] ;
    sh:targetClass datamodel:vault .

datamodel:FullName a sh:NodeShape ;
    sh:closed true ;
    sh:description "Structured full name" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Middle name" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path datamodel:middle_name ],
        [ sh:datatype xsd:string ;
            sh:description "Given or first name" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path datamodel:first_name ],
        [ sh:datatype xsd:string ;
            sh:description "Family or last name" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path datamodel:family_name ] ;
    sh:targetClass datamodel:FullName .

datamodel:WeightC a sh:NodeShape ;
    sh:closed true ;
    sh:description "Weight" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( loinc:3141-9 loinc:3142-7 ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path datamodel:type ],
        [ sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path datamodel:mass_in_kg ] ;
    sh:targetClass datamodel:WeightC .

