    owl:intersectionOf ( [ owl:intersectionOf ( [ a owl:Restriction ;
                            owl:onProperty <https://w3id.org/faqir/datamodel/:isEmptyAnswer> ;
                            owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
