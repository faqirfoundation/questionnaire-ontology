@prefix datamodel: <https://w3id.org/faqir/datamodel/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fhir: <https://www.hl7.org/fhir/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix loinc: <https://loinc.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix questionnaire: <https://w3id.org/faqir/datamodel/questionnaire/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix types: <https://w3id.org/faqir/datamodel/core/types> .
@prefix ucum: <https://unitsofmeasure.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/faqir/datamodel.owl.ttl> a owl:Ontology ;
    rdfs:label "datamodel" ;
    dcterms:license "MIT" ;
    dcterms:title "datamodel" ;
    rdfs:seeAlso <https://faqir.github.io/datamodel> ;
    skos:definition "The datamodel used in faqir vaults." .

<https://w3id.org/faqir/datamodel/:MassUnit> a owl:Class ;
    linkml:permissible_values ucum:kg .

<https://w3id.org/faqir/datamodel/vault/FullName> a owl:Class ;
    rdfs:label "FullName" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/first_name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/first_name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/first_name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/family_name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/middle_name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/family_name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/family_name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/middle_name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/middle_name> ] ;
    skos:definition "Structured full name." ;
    skos:inScheme datamodel:vault .

<https://w3id.org/faqir/datamodel/vault/hasQuestionnaireResponse> a owl:ObjectProperty ;
    rdfs:label "hasQuestionnaireResponse" ;
    rdfs:domain <https://w3id.org/faqir/datamodel/vault/Vault> ;
    rdfs:range <https://w3id.org/faqir/datamodel/questionnaire/classes/QuestionnaireResponse> ;
    owl:inverseOf <https://w3id.org/faqir/datamodel/questionnaire/relationship_slots/bySubject> ;
    skos:definition "QuestionnaireResponse authored by this vault's user." ;
    skos:inScheme datamodel:vault .

loinc:3141-9 a owl:Class ;
    rdfs:label "BODY_WEIGHT_MEASURED" ;
    rdfs:subClassOf <https://w3id.org/faqir/datamodel/:WeightType> .

loinc:3142-7 a owl:Class ;
    rdfs:label "BODY_WEIGHT_STATED" ;
    rdfs:subClassOf <https://w3id.org/faqir/datamodel/:WeightType> .

ucum:cm a owl:Class ;
    rdfs:label "cm" ;
    rdfs:subClassOf <https://w3id.org/faqir/datamodel/:UnitOfMeasure> .

ucum:g a owl:Class ;
    rdfs:label "g" ;
    rdfs:subClassOf <https://w3id.org/faqir/datamodel/:UnitOfMeasure> .

ucum:h a owl:Class ;
    rdfs:label "h" ;
    rdfs:subClassOf <https://w3id.org/faqir/datamodel/:UnitOfMeasure> .

ucum:lb_av a owl:Class ;
    rdfs:label "lb" ;
    rdfs:subClassOf <https://w3id.org/faqir/datamodel/:UnitOfMeasure> .

ucum:m a owl:Class ;
    rdfs:label "m" ;
    rdfs:subClassOf <https://w3id.org/faqir/datamodel/:UnitOfMeasure> .

ucum:min a owl:Class ;
    rdfs:label "min" ;
    rdfs:subClassOf <https://w3id.org/faqir/datamodel/:UnitOfMeasure> .

<https://w3id.org/faqir/datamodel/core/types/ValueCoding> a owl:Class ;
    rdfs:label "ValueCoding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/code> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/display> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/code> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/display> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/code> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/display> ] ;
    skos:definition "A coded value with a unique code for each display text, typically used for standardized questionnaires." ;
    skos:exactMatch fhir:Coding ;
    skos:inScheme types: .

<https://w3id.org/faqir/datamodel/core/types/ValueDateTime> a owl:Class ;
    rdfs:label "ValueDateTime" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/dateTimeValue> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/dateTimeValue> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/dateTimeValue> ] ;
    skos:definition "A date and time value, typically in ISO 8601 format." ;
    skos:exactMatch xsd:dateTime ;
    skos:inScheme types: .

<https://w3id.org/faqir/datamodel/core/types/ValueString> a owl:Class ;
    rdfs:label "ValueString" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/stringValue> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/stringValue> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/stringValue> ] ;
    skos:definition "A string value, typically used for text or identifiers." ;
    skos:exactMatch xsd:string ;
    skos:inScheme types: .

<https://w3id.org/faqir/datamodel/questionnaire/general_slots/IntervalParams> a owl:Class ;
    rdfs:label "IntervalParams" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/questionnaire/general_slots/minLabel> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/questionnaire/general_slots/maxLabel> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/questionnaire/general_slots/minValue> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/faqir/datamodel/questionnaire/general_slots/minLabel> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/questionnaire/general_slots/maxValue> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/questionnaire/general_slots/maxLabel> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/questionnaire/general_slots/minValue> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/questionnaire/general_slots/maxValue> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://w3id.org/faqir/datamodel/questionnaire/general_slots/minValue> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/questionnaire/general_slots/minLabel> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/faqir/datamodel/questionnaire/general_slots/maxLabel> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://w3id.org/faqir/datamodel/questionnaire/general_slots/maxValue> ] ;
    skos:definition "Parameters for interval values, including minimum and maximum values." ;
    skos:exactMatch datamodel:IntervalParams ;
    skos:inScheme questionnaire:general_slots .

<https://w3id.org/faqir/datamodel/questionnaire/general_slots/NumericalParams> a owl:Class ;
    rdfs:label "NumericalParams" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/faqir/datamodel/:UnitOfMeasure> ;
            owl:onProperty <https://w3id.org/faqir/datamodel/questionnaire/general_slots/numericalUnit> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/questionnaire/general_slots/numericalPrecision> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/questionnaire/general_slots/numericalUnit> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty <https://w3id.org/faqir/datamodel/questionnaire/general_slots/numericalPrecision> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/questionnaire/general_slots/numericalPrecision> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/questionnaire/general_slots/numericalUnit> ] ;
    skos:definition "Parameters for quantitative values, including unit and precision." ;
    skos:exactMatch datamodel:NumericalParams ;
    skos:inScheme questionnaire:general_slots .

<https://w3id.org/faqir/datamodel/questionnaire/general_slots/answerValueString> a owl:ObjectProperty ;
    rdfs:label "answerValueString" ;
    rdfs:range <https://w3id.org/faqir/datamodel/core/types/ValueString> ;
    skos:definition "The value of the answer to a choice, openChoice or text type of question, which is a stringValue." ;
    skos:inScheme questionnaire:general_slots ;
    skos:mappingRelation fhir:QuestionnaireResponse.item.answer.valueString .

<https://w3id.org/faqir/datamodel/questionnaire/general_slots/codingQuestionParams> a owl:ObjectProperty ;
    rdfs:label "codingQuestionParams" ;
    rdfs:range <https://w3id.org/faqir/datamodel/core/types/ValueCoding> ;
    skos:definition "Code and Display of each option offered as answer to the choice or open-choice question." ;
    skos:inScheme questionnaire:general_slots .

<https://w3id.org/faqir/datamodel/questionnaire/general_slots/intervalQuestionParams> a owl:ObjectProperty ;
    rdfs:label "intervalQuestionParams" ;
    rdfs:range <https://w3id.org/faqir/datamodel/questionnaire/general_slots/IntervalParams> ;
    skos:definition "Minimum and Maximum limiting the range the answer must be in for the question." ;
    skos:inScheme questionnaire:general_slots .

<https://w3id.org/faqir/datamodel/questionnaire/general_slots/numericalQuestionParams> a owl:ObjectProperty ;
    rdfs:label "numericalQuestionParams" ;
    rdfs:range <https://w3id.org/faqir/datamodel/questionnaire/general_slots/NumericalParams> ;
    skos:definition "Unit and Precision limiting the quantitative answer for the question." ;
    skos:inScheme questionnaire:general_slots .

<https://w3id.org/faqir/datamodel/vault/Weight> a owl:Class ;
    rdfs:label "Weight" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/faqir/datamodel/:WeightType> ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/weightType> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/weightType> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/vault/weightType> ],
        <https://w3id.org/faqir/datamodel/core/types/ValueNumerical> ;
    skos:definition "Weight." ;
    skos:inScheme datamodel:vault .

fhir:choice a owl:Class ;
    rdfs:label "choice" ;
    rdfs:subClassOf <https://w3id.org/faqir/datamodel/:QuestionType> .

fhir:dateTime a owl:Class ;
    rdfs:label "dateTime" ;
    rdfs:subClassOf <https://w3id.org/faqir/datamodel/:QuestionType> .

fhir:decimal a owl:Class ;
    rdfs:label "decimal" ;
    rdfs:subClassOf <https://w3id.org/faqir/datamodel/:QuestionType> .

fhir:number a owl:Class ;
    rdfs:label "numberInterval" ;
    rdfs:subClassOf <https://w3id.org/faqir/datamodel/:QuestionType> .

fhir:open-choice a owl:Class ;
    rdfs:label "openChoice" ;
    rdfs:subClassOf <https://w3id.org/faqir/datamodel/:QuestionType> .

fhir:string a owl:Class ;
    rdfs:label "text" ;
    rdfs:subClassOf <https://w3id.org/faqir/datamodel/:QuestionType> .

ucum:kg a owl:Class ;
    rdfs:label "kg" ;
    rdfs:subClassOf <https://w3id.org/faqir/datamodel/:MassUnit>,
        <https://w3id.org/faqir/datamodel/:UnitOfMeasure> .

<https://w3id.org/faqir/datamodel/:WeightType> a owl:Class ;
    owl:unionOf ( loinc:3141-9 loinc:3142-7 ) ;
    linkml:permissible_values loinc:3141-9,
        loinc:3142-7 .

<https://w3id.org/faqir/datamodel/core/types/ValueNumerical> a owl:Class ;
    rdfs:label "ValueNumerical" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/numericalValue> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/numericalValue> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/types/numericalValue> ] ;
    skos:definition "Base class for quantitative values, they may have units and precision." ;
    skos:exactMatch datamodel:ValueNumerical ;
    skos:inScheme types: .

<https://w3id.org/faqir/datamodel/core/types/code> a owl:DatatypeProperty ;
    rdfs:label "code" ;
    skos:definition "The code representing the value (e.g. code '1' for value 'Yes')." ;
    skos:inScheme types: .

<https://w3id.org/faqir/datamodel/core/types/dateTimeValue> a owl:DatatypeProperty ;
    rdfs:label "dateTimeValue" ;
    skos:definition "The date and time value in ISO 8601 format." ;
    skos:inScheme types: .

<https://w3id.org/faqir/datamodel/core/types/display> a owl:DatatypeProperty ;
    rdfs:label "display" ;
    skos:definition "The human-readable display text for the code (e.g. code '1' for value 'Yes')." ;
    skos:inScheme types: .

<https://w3id.org/faqir/datamodel/core/types/numericalValue> a owl:DatatypeProperty ;
    rdfs:label "numericalValue" ;
    skos:definition "The quantitative value, which can be an integer or a float." ;
    skos:inScheme types: .

<https://w3id.org/faqir/datamodel/core/types/stringValue> a owl:DatatypeProperty ;
    rdfs:label "stringValue" ;
    skos:definition "The string value, which can be any text." ;
    skos:inScheme types: .

<https://w3id.org/faqir/datamodel/core/versions/Metadata> a owl:Class ;
    rdfs:label "Metadata" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/versions/schemaVersion> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/versions/lastUpdated> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/versions/lastUpdated> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/versions/schemaVersion> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/versions/lastUpdated> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^\\d+\\.\\d+\\.\\d+$" ] ) ] ) ] ;
            owl:onProperty <https://w3id.org/faqir/datamodel/core/versions/schemaVersion> ] ;
    skos:definition "Base class for metadata tracking (e.g. schema versioning & last updated)." ;
    skos:inScheme <https://w3id.org/faqir/datamodel/core/versions> .

<https://w3id.org/faqir/datamodel/core/versions/lastUpdated> a owl:DatatypeProperty ;
    rdfs:label "lastUpdated" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The date and time when the schema was last updated." ;
    skos:inScheme <https://w3id.org/faqir/datamodel/core/versions> .

<https://w3id.org/faqir/datamodel/core/versions/schemaVersion> a owl:DatatypeProperty ;
    rdfs:label "schemaVersion" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^\\d+\\.\\d+\\.\\d+$" ] ) ] ) ] ;
    skos:definition "The version of the schema." ;
    skos:inScheme <https://w3id.org/faqir/datamodel/core/versions> .

<https://w3id.org/faqir/datamodel/questionnaire/general_slots/answerId> a owl:DatatypeProperty ;
    rdfs:label "answerId" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^https://pods.faqir.org/[^\\s]++$" ] ) ] ;
    rdfs:subPropertyOf <https://w3id.org/faqir/datamodel/core/identifiers/id> ;
    skos:definition "The unique identifier for an answer in the questionnaire response." ;
    skos:inScheme questionnaire:general_slots .

<https://w3id.org/faqir/datamodel/questionnaire/general_slots/answerTimeStamp> a owl:DatatypeProperty ;
    rdfs:label "answerTimeStamp" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The exact date and time when the answer was provided" ;
    skos:inScheme questionnaire:general_slots .

<https://w3id.org/faqir/datamodel/questionnaire/general_slots/answerValueDateTime> a owl:ObjectProperty ;
    rdfs:label "answerValueDateTime" ;
    rdfs:range <https://w3id.org/faqir/datamodel/core/types/ValueDateTime> ;
    skos:definition "The value of the answer to a dateTime type of question, which is a datetime value." ;
    skos:inScheme questionnaire:general_slots ;
    skos:mappingRelation fhir:QuestionnaireResponse.item.answer.valueDateTime .

<https://w3id.org/faqir/datamodel/questionnaire/general_slots/answerValueNumerical> a owl:ObjectProperty ;
    rdfs:label "answerValueNumerical" ;
    rdfs:range <https://w3id.org/faqir/datamodel/core/types/ValueNumerical> ;
    skos:definition "The value of the answer to a decimal or numberInterval type of question, which is a numeric value." ;
    skos:inScheme questionnaire:general_slots ;
    skos:mappingRelation fhir:QuestionnaireResponse.item.answer.valueDecimal .

<https://w3id.org/faqir/datamodel/questionnaire/general_slots/isEmptyAnswer> a owl:DatatypeProperty ;
    rdfs:label "isEmptyAnswer" ;
    rdfs:range xsd:boolean ;
    skos:definition "True if the answer is intentionally empty." ;
    skos:inScheme questionnaire:general_slots .

<https://w3id.org/faqir/datamodel/questionnaire/general_slots/maxLabel> a owl:DatatypeProperty ;
    rdfs:label "maxLabel" ;
    skos:definition "The label for the maximum value of the interval." ;
    skos:inScheme questionnaire:general_slots .

<https://w3id.org/faqir/datamodel/questionnaire/general_slots/maxValue> a owl:DatatypeProperty ;
    rdfs:label "maxValue" ;
    skos:definition "The maximum value of the interval." ;
    skos:inScheme questionnaire:general_slots .

<https://w3id.org/faqir/datamodel/questionnaire/general_slots/minLabel> a owl:DatatypeProperty ;
    rdfs:label "minLabel" ;
    skos:definition "The label for the maximum value of the interval." ;
    skos:inScheme questionnaire:general_slots .

<https://w3id.org/faqir/datamodel/questionnaire/general_slots/minValue> a owl:DatatypeProperty ;
    rdfs:label "minValue" ;
    skos:definition "The minimum value of the interval." ;
    skos:inScheme questionnaire:general_slots .

<https://w3id.org/faqir/datamodel/questionnaire/general_slots/numericalPrecision> a owl:DatatypeProperty ;
    rdfs:label "numericalPrecision" ;
    skos:definition "The precision of the quantitative value, e.g. number of decimal places." ;
    skos:inScheme questionnaire:general_slots .

<https://w3id.org/faqir/datamodel/questionnaire/general_slots/numericalUnit> a owl:ObjectProperty ;
    rdfs:label "numericalUnit" ;
    skos:definition "The unit of measure for the quantitative value, from UCUM standard." ;
    skos:inScheme questionnaire:general_slots .

<https://w3id.org/faqir/datamodel/questionnaire/general_slots/questionId> a owl:DatatypeProperty ;
    rdfs:label "questionId" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^https://pods.faqir.org/[^\\s]++$" ] ) ] ;
    rdfs:subPropertyOf <https://w3id.org/faqir/datamodel/core/identifiers/id> ;
    skos:definition "The unique identifier for a question in the questionnaire." ;
    skos:inScheme questionnaire:general_slots .

