@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fhir: <http://hl7.org/fhir/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix omop: <https://www.ohdsi.org/data-standardization/> .
@prefix openEHR: <http://openehr.org/v1/StructureDefinition/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix phro: <https://ns.faqir.org/phr-o#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qo: <https://ns.faqir.org/q-o#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s4ehaw: <https://saref.etsi.org/saref4ehaw/> .
@prefix saref: <https://saref.etsi.org/core/> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix sulo: <https://aidava-dev.github.io/sulo/ontospy/index.html> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

prov:generated a owl:ObjectProperty ;
    rdfs:label "prov_generated" ;
    rdfs:domain qo:SuloProcess ;
    rdfs:range qo:OwlThing ;
    owl:inverseOf prov:wasGeneratedBy ;
    skos:definition "Generation is the completion of production of a new entity by an activity. This entity did not exist before generation and becomes available for usage after this generation." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

prov:qualifiedAttribution a owl:ObjectProperty ;
    rdfs:label "prov_qualifiedAttribution" ;
    rdfs:domain qo:ProvEntity ;
    rdfs:range qo:ProvAttribution ;
    skos:definition "Attribution is the ascribing of an entity to an agent. When an entity e is attributed to agent ag, entity e was generated by some unspecified activity that in turn was associated to agent ag. Thus, this relation is useful when the activity is not known, or irrelevant." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:FhirProcedure a owl:Class ;
    rdfs:label "fhir_Procedure" ;
    rdfs:subClassOf qo:SuloProcess ;
    skos:definition "An action that is being or was performed on an individual or entity" ;
    skos:exactMatch fhir:Procedure ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:S4ehawActivity a owl:Class ;
    rdfs:label "s4ehaw_Activity" ;
    rdfs:subClassOf qo:SuloProcess ;
    skos:definition "The activity of a patient/user, i.e. daily and nocturnal activities." ;
    skos:exactMatch s4ehaw:activity ;
    skos:inScheme <https://ns.faqir.org/q-o> .

<https://ns.faqir.org/q-o.owl.ttl> a owl:Ontology ;
    rdfs:label "Questionnaire-Ontology" ;
    dcterms:contributor <https://orcid.org/0000-0001-9913-3898>,
        <https://orcid.org/0000-0002-9685-5016>,
        <https://orcid.org/0000-0003-0858-6651>,
        <https://orcid.org/0009-0003-8884-7838>,
        <https://orcid.org/0009-0007-4180-1305> ;
    dcterms:license "Apache Software License 2.0" ;
    dcterms:title "Questionnaire Ontology" ;
    pav:createdOn "2026-09-30T00:00:00+00:00" ;
    pav:version "2.0.0" ;
    rdfs:seeAlso <https://github.com/faqirfoundation/questionnaire-ontology> ;
    skos:definition "FAQIR Questionnaire Ontology" .

s4ehaw:maximumValue a owl:DatatypeProperty ;
    rdfs:label "s4ehaw_maximumValue" ;
    rdfs:range xsd:float ;
    skos:definition "The maximum allowable value of a measurement." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

s4ehaw:minimumValue a owl:DatatypeProperty ;
    rdfs:label "s4ehaw_minimumValue" ;
    rdfs:range xsd:float ;
    skos:definition "The minimum allowable value of a measurement." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

time:hasDuration a owl:ObjectProperty ;
    rdfs:label "time_hasDuration" ;
    rdfs:range qo:TimeDuration ;
    skos:definition "Duration of a temporal entity, expressed as a scaled value or nominal value" ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    skos:mappingRelation sphn:hasDuration .

qo:FhirValueRatio a owl:Class ;
    rdfs:label "fhir_ValueRatio" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty qo:numerator ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:QuantityValue ;
            owl:onProperty qo:denominator ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty qo:denominator ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:QuantityValue ;
            owl:onProperty qo:numerator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:denominator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:numerator ] ;
    skos:definition "A ratio of two Quantity values - a numerator and a denominator" ;
    skos:exactMatch fhir:Ratio ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:FoafPerson a owl:Class ;
    rdfs:label "foaf_Person" ;
    rdfs:subClassOf qo:FoafAgent ;
    skos:definition "A person." ;
    skos:exactMatch foaf:Person ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    skos:mappingRelation fhir:Person,
        schema1:Person,
        omop:Person .

qo:IntervalParams a owl:Class ;
    rdfs:label "IntervalParams" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:minValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty qo:maxValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty qo:maxLabel ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:maxLabel ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty qo:minValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:minLabel ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:maxValue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:minValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty qo:minLabel ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:maxValue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:minLabel ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:maxLabel ] ;
    skos:definition "Parameters for interval values, including minimum and maximum values." ;
    skos:exactMatch phro:IntervalParams ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:NumericalParams a owl:Class ;
    rdfs:label "NumericalParams" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:numericalUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^ucum:" ] ) ] ) ] ;
            owl:onProperty qo:numericalUnit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:numericalPrecision ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty qo:numericalPrecision ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:numericalPrecision ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:numericalUnit ] ;
    skos:definition "Parameters for quantitative values, including unit and precision." ;
    skos:exactMatch phro:NumericalParams ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:ProvAttribution a owl:Class ;
    rdfs:label "prov_Attribution" ;
    skos:definition "An instance of prov:Attribution provides additional descriptions about the binary prov:wasAttributedTo relation from an prov:Entity to some prov:Agent that had some responsible for it. For example, :cake prov:wasAttributedTo :baker; prov:qualifiedAttribution [ a prov:Attribution; prov:entity :baker; :foo :bar ]." ;
    skos:exactMatch prov:Attribution ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:QoQuestionnaireResponseStatus a owl:Class ;
    rdfs:label "qo_QuestionnaireResponseStatus" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom qo:QuestionnaireResponseStatusEnum ;
            owl:onProperty saref:hasValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty saref:hasValue ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty saref:hasValue ],
        qo:SarefPropertyValue ;
    skos:definition "Defines the lifecycle state governing the operational readiness and availability of a completed or partially completed instance containing recorded values collected from a specific execution of a survey instrument." ;
    skos:exactMatch qo:QuestionnaireResponseStatus ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:QoQuestionnaireStatus a owl:Class ;
    rdfs:label "qo_QuestionnaireStatus" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom qo:QuestionnaireStatusEnum ;
            owl:onProperty saref:hasValue ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty saref:hasValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty saref:hasValue ],
        qo:SarefPropertyValue ;
    skos:definition "Defines the lifecycle state governing the operational readiness and availability of a survey template." ;
    skos:exactMatch qo:QuestionnaireStatus ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:TimeInterval a owl:Class ;
    rdfs:label "time_Interval" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty prov:startedAtTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty prov:startedAtTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty prov:endedAtTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:endedAtTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:startedAtTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty prov:endedAtTime ] ;
    skos:definition "A temporal entity with an extent or duration" ;
    skos:exactMatch time:Interval ;
    skos:inScheme <https://ns.faqir.org/q-o> .

<http://hl7.org/fhir/item-type#coding> a owl:Class ;
    rdfs:label "choice" ;
    rdfs:subClassOf qo:QuestionType ;
    skos:definition "An inquiry format offering a fixed set of standardized coded options for selection." ;
    skos:mappingRelation fhir:QuestionnaireResponse.item.answer.valueCoding .

<http://hl7.org/fhir/item-type#dateTime> a owl:Class ;
    rdfs:label "dateTime" ;
    rdfs:subClassOf qo:QuestionType ;
    skos:definition "An inquiry item constraining acceptable input strictly to a date and time, formatted as YYYY-MM-DDThh:mm:ss+zz:zz." ;
    skos:mappingRelation xsd:dateTime .

<http://hl7.org/fhir/item-type#decimal> a owl:Class ;
    rdfs:label "decimal" ;
    rdfs:subClassOf qo:QuestionType ;
    skos:definition "A question that expects a numerical answer, either integer or float." ;
    skos:narrowMatch xsd:decimal,
        xsd:float,
        xsd:integer .

<http://hl7.org/fhir/item-type#string> a owl:Class ;
    rdfs:label "text" ;
    rdfs:subClassOf qo:QuestionType ;
    skos:definition "An inquiry item that expects a free string answer." ;
    skos:mappingRelation xsd:string .

<http://hl7.org/fhir/item-type#time> a owl:Class ;
    rdfs:label "time" ;
    rdfs:subClassOf qo:QuestionType ;
    skos:definition "An inquiry item constraining acceptable input strictly to a clock time (hour, minute, second) without a date component." ;
    skos:mappingRelation xsd:time .

fhir:questionnaire-answers-status-amended a owl:Class ;
    rdfs:label "amended" ;
    rdfs:subClassOf qo:QuestionnaireResponseStatusEnum ;
    skos:definition "This QuestionnaireResponse has been filled out with answers, then marked as complete, yet changes or additions have been made to it afterwards." ;
    skos:mappingRelation fhir:valueset-resource-status.html .

fhir:questionnaire-answers-status-completed a owl:Class ;
    rdfs:label "completed" ;
    rdfs:subClassOf qo:QuestionnaireResponseStatusEnum ;
    skos:definition "This QuestionnaireResponse has been filled out with answers and the current content is regarded as definitive." ;
    skos:mappingRelation fhir:valueset-resource-status.html .

fhir:questionnaire-answers-status-entered-in-error a owl:Class ;
    rdfs:label "entered_in_error" ;
    rdfs:subClassOf qo:QuestionnaireResponseStatusEnum ;
    skos:definition "This QuestionnaireResponse was entered in error and voided." ;
    skos:mappingRelation fhir:valueset-resource-status.html .

fhir:questionnaire-answers-status-in-progress a owl:Class ;
    rdfs:label "in_progress" ;
    rdfs:subClassOf qo:QuestionnaireResponseStatusEnum ;
    skos:definition "This QuestionnaireResponse has been partially filled out with answers but changes or additions are still expected to be made to it." ;
    skos:mappingRelation fhir:valueset-resource-status.html .

fhir:questionnaire-answers-status-stopped a owl:Class ;
    rdfs:label "stopped" ;
    rdfs:subClassOf qo:QuestionnaireResponseStatusEnum ;
    skos:definition "This QuestionnaireResponse has been partially filled out with answers but has been abandoned. No subsequent changes can be made." ;
    skos:mappingRelation fhir:valueset-resource-status.html .

fhir:resource-status-active a owl:Class ;
    rdfs:label "active" ;
    rdfs:subClassOf qo:QuestionnaireStatusEnum ;
    skos:definition "This resource is ready for normal use." ;
    skos:mappingRelation <http://hl7.org/fhir/codesystem-resource-status.html#resource-status-active> .

fhir:resource-status-draft a owl:Class ;
    rdfs:label "draft" ;
    rdfs:subClassOf qo:QuestionnaireStatusEnum ;
    skos:definition "This resource is still under development and is not yet considered to be ready for normal use." ;
    skos:mappingRelation <http://hl7.org/fhir/codesystem-resource-status.html#resource-status-draft> .

fhir:resource-status-retired a owl:Class ;
    rdfs:label "retired" ;
    rdfs:subClassOf qo:QuestionnaireStatusEnum ;
    skos:definition "This resource has been withdrawn or superseded and should no longer be used." ;
    skos:mappingRelation <http://hl7.org/fhir/codesystem-resource-status.html#resource-status-inactive> .

fhir:resource-status-unknown a owl:Class ;
    rdfs:label "unknown" ;
    rdfs:subClassOf qo:QuestionnaireStatusEnum ;
    skos:definition "The authoring system does not know which of the status values currently applies for this resource. Note: This concept is not to be used for 'other' - one of the listed statuses is presumed to apply, it's just not known which one." ;
    skos:mappingRelation <http://hl7.org/fhir/codesystem-resource-status.html#resource-status-unknown> .

rdfs:comment a owl:DatatypeProperty ;
    rdfs:label "rdfs_comment" ;
    rdfs:domain qo:OwlThing ;
    rdfs:range xsd:string ;
    skos:definition "A textual comment helps clarify the meaning of RDF classes and properties. Such in-line documentation complements the use of both formal techniques (Ontology and rule languages) and informal (prose documentation, examples, test cases). A variety of documentation forms can be combined to indicate the intended meaning of the classes and properties described in an RDF vocabulary. Since RDF vocabularies are expressed as RDF graphs, vocabularies defined in other namespaces may be used to provide richer documentation." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

rdfs:label a owl:DatatypeProperty ;
    rdfs:label "rdfs_label" ;
    rdfs:domain qo:OwlThing ;
    rdfs:range xsd:string ;
    skos:definition "human-readable version of a resource's name. Multilingual labels are supported using the language tagging facility of RDF literals." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

prov:hadPrimarySource a owl:ObjectProperty ;
    rdfs:label "prov_hadPrimarySource" ;
    rdfs:domain qo:OwlThing ;
    rdfs:range qo:ProvEntity ;
    skos:definition "A primary source for a topic refers to something produced by some agent with direct experience and knowledge about the topic, at the time of the topic's study, without benefit from hindsight. Because of the directness of primary sources, they 'speak for themselves' in ways that cannot be captured through the filter of secondary sources. As such, it is important for secondary sources to reference those primary sources from which they were derived, so that their reliability can be investigated. A primary source relation is a particular case of derivation of secondary materials from their primary sources. It is recognized that the determination of primary sources can be up to interpretation, and should be done according to conventions accepted within the application's domain." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:FhirReferenceRange a owl:Class ;
    rdfs:label "fhir_ReferenceRange" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:lowRange ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:QuantityValue ;
            owl:onProperty qo:normalValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:QuantityValue ;
            owl:onProperty qo:highRange ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:highRange ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:normalValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:highRange ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:QuantityValue ;
            owl:onProperty qo:lowRange ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:lowRange ] ;
    skos:definition "Guidance on how to interpret the value by comparison to a normal or recommended range. Multiple reference ranges are interpreted as an 'OR'. In other words, to represent two distinct target populations, two referenceRange elements would be used." ;
    skos:exactMatch fhir:Observation.referenceRange ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:QoQuestionnaire a owl:Class ;
    rdfs:label "qo_Questionnaire" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcterms:creator ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dcterms:modified ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:SuloProcess ;
            owl:onProperty dcterms:isPartOf ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcterms:modified ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fhir:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:ProvOrganization ;
            owl:onProperty dcterms:creator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:hasOrderedSection ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcterms:isPartOf ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcterms:created ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:QoQuestionnaireStatus ;
            owl:onProperty fhir:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:QoOrderedSection ;
            owl:onProperty qo:hasOrderedSection ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcterms:modified ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dcterms:created ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:QoOrderedQuestion ;
            owl:onProperty qo:hasOrderedQuestion ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcterms:created ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:hasOrderedQuestion ],
        qo:ProvEntity ;
    skos:definition "A structured, reusable instrument or template composed of ordered items designed to collect standardized information from an individual or system." ;
    skos:exactMatch qo:Questionnaire ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    skos:narrowMatch fhir:Questionnaire .

qo:QoQuestionnaireResponse a owl:Class ;
    rdfs:label "qo_QuestionnaireResponse" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcterms:created ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:responds ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fhir:status ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty prov:wasAttributedTo ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty qo:responds ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:QoAnswer ;
            owl:onProperty qo:hasAnswer ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcterms:modified ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty qo:hasAnswer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcterms:modified ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:QoQuestionnaireResponseStatus ;
            owl:onProperty fhir:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dcterms:created ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dcterms:modified ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:SuloProcess ;
            owl:onProperty dcterms:isPartOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:FoafPerson ;
            owl:onProperty prov:wasAttributedTo ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcterms:created ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcterms:isPartOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:QoQuestionnaire ;
            owl:onProperty qo:responds ],
        qo:ProvEntity ;
    skos:definition "A completed or partially completed instance containing recorded values collected from a specific execution of a survey instrument." ;
    skos:exactMatch qo:QuestionnaireResponse ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:QoSection a owl:Class ;
    rdfs:label "qo_Section" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom qo:ProvOrganization ;
            owl:onProperty dcterms:creator ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcterms:creator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:hasOrderedSection ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:hasOrderedQuestion ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:QoOrderedSection ;
            owl:onProperty qo:hasOrderedSection ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:QoOrderedQuestion ;
            owl:onProperty qo:hasOrderedQuestion ],
        qo:ProvEntity ;
    skos:definition "A logical grouping or thematic partition of items within a structured survey instrument." ;
    skos:exactMatch qo:Section ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    skos:narrowMatch <http://hl7.org/fhir/Questionnaire.item.where(type='group')> .

qo:ValueCoding a owl:Class ;
    rdfs:label "ValueCoding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:display ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty qo:display ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:code ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty qo:code ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty qo:display ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty qo:code ] ;
    skos:definition "A coded value with a unique code for each display text, typically used for standardized questionnaires." ;
    skos:exactMatch fhir:Coding ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:hasAnswer a owl:ObjectProperty ;
    rdfs:label "qo_hasAnswer" ;
    rdfs:domain qo:QoQuestionnaireResponse ;
    rdfs:range qo:QoAnswer ;
    skos:definition "Associates a recorded instance with its constituent individual response values." ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    skos:narrowMatch fhir:QuestionnaireResponse.item.answer .

qo:normalValue a owl:ObjectProperty ;
    rdfs:label "normalValue" ;
    skos:definition "Normal value, if relevant." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:numberInterval a owl:Class ;
    rdfs:label "numberInterval" ;
    rdfs:subClassOf qo:QuestionType ;
    skos:definition "A question that expects a numeric answer in between a minimum and maximum value." ;
    skos:narrowMatch fhir:QuestionnaireResponse.item.answer.valueInteger,
        xsd:decimal,
        xsd:float,
        xsd:integer .

qo:open-choice a owl:Class ;
    rdfs:label "openChoice" ;
    rdfs:subClassOf qo:QuestionType ;
    skos:definition "A question with predefined options to select from plus a last valueCoding: {'code': '-1', 'display': 'Other'} that allows text input. Multiple selection may be allowed." ;
    skos:narrowMatch fhir:QuestionnaireResponse.item.answer.valueCoding .

qo:tag a owl:DatatypeProperty ;
    rdfs:label "qo_tag" ;
    skos:definition "A machine-readable alphanumeric code or mnemonic string used for internal reference and translation lookup." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

fhir:referenceRange a owl:ObjectProperty ;
    rdfs:label "fhir_referenceRange" ;
    skos:definition "Guidance on how to interpret the value by comparison to a normal or recommended range. Multiple reference ranges are interpreted as an 'OR'. In other words, to represent two distinct target populations, two referenceRange elements would be used." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

fhir:valueAttachment a owl:DatatypeProperty ;
    rdfs:label "fhir_valueAttachment" ;
    skos:definition "This type is for containing or referencing attachments - additional data content defined in other formats. The most common use of this type is to include images or reports in some report format such as PDF. However, it can be used for any data that has a MIME type." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

fhir:valueCodeableConcept a owl:ObjectProperty ;
    rdfs:label "fhir_valueCodeableConcept" ;
    skos:definition "A CodeableConcept represents a value that is usually supplied by providing a reference to one or more terminologies or ontologies but may also be defined by the provision of text. This is a common pattern in healthcare data." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

fhir:valuePeriod a owl:ObjectProperty ;
    rdfs:label "fhir_valuePeriod" ;
    skos:definition "A time period defined by a start and end date/time. A period specifies a range of times. The context of use will specify whether the entire range applies (e.g. 'the patient was an inpatient of the hospital for this time range') or one value from the period applies (e.g. 'give to the patient between 2 and 4 pm on 24-Jun 2013')." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

fhir:valueRange a owl:ObjectProperty ;
    rdfs:label "fhir_valueRange" ;
    skos:definition "A set of ordered Quantity values defined by a low and high limit." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

fhir:valueRatio a owl:ObjectProperty ;
    rdfs:label "fhir_valueRatio" ;
    skos:definition "A relationship between two Quantity values expressed as a numerator and a denominator. The Ratio datatype should only be used to express a relationship of two numbers if the relationship cannot be suitably expressed using a Quantity and a common unit. Where the denominator value is known to be fixed to '1', Quantity should be used instead of Ratio." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

fhir:valueReference a owl:DatatypeProperty ;
    rdfs:label "fhir_valueReference" ;
    rdfs:range xsd:anyURI ;
    skos:definition "The Reference type contains at least one of a reference (literal reference), an identifier (logical reference), and a display (text description of target). In addition, it may contain a target type." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

owl:versionInfo a owl:DatatypeProperty ;
    rdfs:label "owl_versionInfo" ;
    rdfs:domain qo:OwlThing ;
    rdfs:range xsd:string ;
    skos:closeMatch saref:hasVersion ;
    skos:definition "An owl:versionInfo statement generally has as its object a string giving information about this version, for example RCS/CVS keywords. This statement does not contribute to the logical meaning of the ontology other than that given by the RDF(S) model theory." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

prov:atTime a owl:DatatypeProperty ;
    rdfs:label "prov_atTime" ;
    rdfs:domain qo:SuloProcess ;
    rdfs:range xsd:dateTime ;
    skos:definition "The time at which an InstantaneousEvent occurred." ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    skos:mappingRelation fhir:DeviceMetric.calibration.time,
        sosa:phenomenonTime,
        saref:hasTimestamp .

prov:wasGeneratedBy a owl:ObjectProperty ;
    rdfs:label "prov_wasGeneratedBy" ;
    rdfs:domain qo:OwlThing ;
    rdfs:range qo:SuloProcess ;
    skos:definition "Generation is the completion of production of a new entity by an activity. This entity did not exist before generation and becomes available for usage after this generation." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:ProvOrganization a owl:Class ;
    rdfs:label "prov_Organization" ;
    rdfs:subClassOf qo:FoafAgent ;
    skos:definition "An organization is a social or legal institution such as a company, society, etc." ;
    skos:exactMatch fhir:Organization,
        openEHR:Organisation,
        prov:Organization,
        foaf:Organization ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:QoAnswer a owl:Class ;
    rdfs:label "qo_Answer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:answerValue ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty qo:toQuestion ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty prov:generatedAtTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty qo:isEmpty ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( xsd:float xsd:string xsd:dateTime ) ] ;
            owl:onProperty qo:answerValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty prov:generatedAtTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:isEmpty ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:isEmpty ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:QoQuestion ;
            owl:onProperty qo:toQuestion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:answerValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:toQuestion ],
        qo:ProvEntity ;
    skos:definition "A recorded value, or selection provided in response to a specific inquiry item." ;
    skos:exactMatch qo:Answer ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    skos:mappingRelation fhir:QuestionnaireResponse.item.answer .

qo:TimeDuration a owl:Class ;
    rdfs:label "time_Duration" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty saref:isMeasuredIn ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^ucum:" ] ) ] ) ] ;
            owl:onProperty saref:isMeasuredIn ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty saref:hasValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty saref:hasValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( xsd:integer xsd:float xsd:double xsd:decimal xsd:date xsd:dateTime xsd:anyURI xsd:string ) ] ;
            owl:onProperty saref:hasValue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty saref:isMeasuredIn ] ;
    skos:definition "Duration of a temporal extent expressed as a decimal number scaled by a temporal unit" ;
    skos:exactMatch time:Duration ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:answerValue a owl:DatatypeProperty ;
    rdfs:label "qo_answerValue" ;
    skos:definition "The recorded literal payload (numeric scalar, textual/coded string, or timestamp) representing the output of a specific inquiry execution." ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    skos:narrowMatch fhir:QuestionnaireResponse.item.answer .

qo:code a owl:DatatypeProperty ;
    rdfs:label "code" ;
    skos:definition "The code representing the value (e.g. code '1' for value 'Yes')." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:codingOrdinal a owl:DatatypeProperty ;
    rdfs:label "qo_codingOrdinal" ;
    skos:definition "Specifies whether permissible selection options possess a meaningful inherent ranking (true) or represent nominal categories (false)." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:codingParams a owl:ObjectProperty ;
    rdfs:label "qo_codingParams" ;
    skos:definition "Defines the permissible standardized concept codes and human-readable labels available for selection." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:conditionalValidity a owl:DatatypeProperty ;
    rdfs:label "qo_conditionalValidity" ;
    rdfs:range xsd:string ;
    skos:definition "A machine-readable rule statement defining an intervening event or state change that revokes the validity of a recorded observation prior to its natural temporal expiration." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:denominator a owl:ObjectProperty ;
    rdfs:label "denominator" ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:display a owl:DatatypeProperty ;
    rdfs:label "display" ;
    skos:definition "The human-readable display text for the code (e.g. code '1' for value 'Yes')." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:hardValidity a owl:DatatypeProperty ;
    rdfs:label "qo_hardValidity" ;
    rdfs:range xsd:boolean ;
    skos:definition "Specifies the operational enforcement mechanism of a duration limit; when true, expiration acts as a strict invalidation threshold for re-use, whereas when false, it serves as a non-binding recommendation." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:highRange a owl:ObjectProperty ;
    rdfs:label "highRange" ;
    skos:definition "High range, if relevant." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:isEmpty a owl:DatatypeProperty ;
    rdfs:label "qo_isEmpty" ;
    skos:definition "Specifies an explicit assertion that an item was purposefully omitted or unpopulated by the respondent rather than skipped due to systemic error." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:lowRange a owl:ObjectProperty ;
    rdfs:label "lowRange" ;
    skos:definition "Low range, if relevant." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:maxLabel a owl:DatatypeProperty ;
    rdfs:label "maxLabel" ;
    skos:definition "The label for the maximum value of the interval." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:maxValue a owl:DatatypeProperty ;
    rdfs:label "maxValue" ;
    skos:definition "The maximum value of the interval." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:minLabel a owl:DatatypeProperty ;
    rdfs:label "minLabel" ;
    skos:definition "The label for the minimum value of the interval." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:minValue a owl:DatatypeProperty ;
    rdfs:label "minValue" ;
    skos:definition "The minimum value of the interval." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:multivalued a owl:DatatypeProperty ;
    rdfs:label "qo_multivalued" ;
    rdfs:range xsd:boolean ;
    skos:definition "Indicates whether this question allows more than one answer (true) or only one (false)." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:numerator a owl:ObjectProperty ;
    rdfs:label "numerator" ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:numericalPrecision a owl:DatatypeProperty ;
    rdfs:label "numericalPrecision" ;
    skos:definition "The precision of the quantitative value, e.g. number of decimal places." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:numericalUnit a owl:DatatypeProperty ;
    rdfs:label "numericalUnit" ;
    skos:definition "The unit of measure for the quantitative value, from UCUM standard." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:question a owl:ObjectProperty ;
    rdfs:label "qo_question" ;
    rdfs:domain qo:QoOrderedQuestion ;
    rdfs:range qo:QoQuestion ;
    rdfs:subPropertyOf dcterms:hasPart ;
    skos:definition "Identifies the specific inquiry item referenced at a given positional index." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:required a owl:DatatypeProperty ;
    rdfs:label "qo_required" ;
    skos:definition "Whether the question can be left un-answered (false) or an answer is mandatory (true)." ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    skos:narrowMatch fhir:Questionnaire.item.required .

qo:responds a owl:ObjectProperty ;
    rdfs:label "qo_responds" ;
    rdfs:domain qo:QoQuestionnaireResponse ;
    rdfs:range qo:QoQuestionnaire ;
    skos:definition "Links a record instance back to the underlying survey template it answers." ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    skos:narrowMatch fhir:QuestionnaireResponse.questionnaire .

qo:section a owl:ObjectProperty ;
    rdfs:label "qo_section" ;
    rdfs:domain qo:QoOrderedSection ;
    rdfs:range qo:QoSection ;
    rdfs:subPropertyOf dcterms:hasPart ;
    skos:definition "Identifies the specific thematic grouping referenced at a given positional index." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:temporalValidity a owl:ObjectProperty ;
    rdfs:label "qo_temporalValidity" ;
    rdfs:range qo:TimeDuration ;
    rdfs:subPropertyOf time:hasDuration ;
    skos:definition "Defines the time extent following generation during which a recorded answer remains valid for automated longitudinal reuse without requiring re-administration." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:toQuestion a owl:ObjectProperty ;
    rdfs:label "qo_toQuestion" ;
    rdfs:domain qo:QoAnswer ;
    rdfs:range qo:QoQuestion ;
    skos:definition "Links a recorded response value back to its originating inquiry item definition." ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    skos:narrowMatch fhir:QuestionnaireResponse.item.answer.question .

saref:isValueOfProperty a owl:ObjectProperty ;
    rdfs:label "saref_isValueOfProperty" ;
    rdfs:domain qo:SarefPropertyValue ;
    rdfs:range qo:SarefProperty ;
    skos:definition "Links a property value to the property or property of interest it is a value of." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

prov:wasAttributedTo a owl:ObjectProperty ;
    rdfs:label "prov_wasAttributedTo" ;
    rdfs:domain qo:ProvEntity ;
    rdfs:range qo:FoafAgent ;
    skos:definition "Attribution is the ascribing of an entity to an agent." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:QoOrderedQuestion a owl:Class ;
    rdfs:label "qo_OrderedQuestion" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:temporalValidity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:order ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:QoQuestion ;
            owl:onProperty qo:question ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:hardValidity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:hardValidity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty qo:hardValidity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:required ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty qo:order ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty qo:required ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty qo:question ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:conditionalValidity ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty qo:temporalValidity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:conditionalValidity ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty qo:required ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:TimeDuration ;
            owl:onProperty qo:temporalValidity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty qo:conditionalValidity ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty qo:order ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:question ],
        qo:ProvEntity ;
    owl:hasKey ( qo:order ) ;
    skos:definition "A contextual wrapper that binds an inquiry item to a specific sequence index within a survey template or parent group." ;
    skos:exactMatch qo:OrderedQuestion ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:QoOrderedSection a owl:Class ;
    rdfs:label "qo_OrderedSection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:order ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty qo:order ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty qo:section ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:QoSection ;
            owl:onProperty qo:section ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:section ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty qo:order ],
        qo:ProvEntity ;
    owl:hasKey ( qo:order ) ;
    skos:definition "A contextual wrapper that binds a thematic grouping of inquiry items to a specific sequence index within a survey template or parent group." ;
    skos:exactMatch qo:OrderedSection ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:hasOrderedQuestion a owl:ObjectProperty ;
    rdfs:label "qo_hasOrderedQuestion" ;
    rdfs:range qo:QoOrderedQuestion ;
    rdfs:subPropertyOf dcterms:hasPart ;
    skos:definition "Associates a survey container or group with a sequence-indexed wrapper holding an individual inquiry item." ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    skos:narrowMatch <http://hl7.org/fhir/Questionnaire.item.where(type='question')> .

qo:hasOrderedSection a owl:ObjectProperty ;
    rdfs:label "qo_hasOrderedSection" ;
    rdfs:range qo:QoOrderedSection ;
    rdfs:subPropertyOf dcterms:hasPart ;
    skos:definition "Associates a survey container or group with a sequence-indexed wrapper holding a nested thematic subgroup." ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    skos:narrowMatch <http://hl7.org/fhir/Questionnaire.item.where(type='group')> .

qo:intervalParams a owl:ObjectProperty ;
    rdfs:label "qo_intervalParams" ;
    skos:definition "Defines lower and upper boundary limits bounding acceptable numeric values." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:QuantityValue a owl:Class ;
    rdfs:label "QuantityValue" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( xsd:integer xsd:float xsd:double xsd:decimal xsd:date xsd:dateTime xsd:anyURI xsd:string ) ] ;
            owl:onProperty saref:hasValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty saref:isMeasuredIn ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^ucum:" ] ) ] ) ] ;
            owl:onProperty saref:isMeasuredIn ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty saref:hasValue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty saref:isMeasuredIn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty saref:hasValue ] ;
    skos:definition "A measured amount (or an amount that can potentially be measured)." ;
    skos:exactMatch fhir:Quantity ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:QuestionnaireStatusEnum a owl:Class ;
    rdfs:label "qo_QuestionnaireStatusEnum" ;
    owl:unionOf ( fhir:resource-status-draft fhir:resource-status-active fhir:resource-status-retired fhir:resource-status-unknown ) ;
    skos:definition "Questionnaires must have one of the following status (FHIR inspired): " ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    linkml:permissible_values fhir:resource-status-active,
        fhir:resource-status-draft,
        fhir:resource-status-retired,
        fhir:resource-status-unknown .

qo:numericalParams a owl:ObjectProperty ;
    rdfs:label "qo_numericalParams" ;
    skos:definition "Specifies measurement units and decimal precision constraints governing acceptable quantitative input." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

prov:endedAtTime a owl:DatatypeProperty ;
    rdfs:label "prov_endedAtTime" ;
    rdfs:domain qo:SuloProcess ;
    rdfs:range xsd:dateTime ;
    skos:definition "The time at which an activity ended." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

prov:generatedAtTime a owl:DatatypeProperty ;
    rdfs:label "prov_generatedAtTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The time at which an entity was completely created and is available for use." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

prov:startedAtTime a owl:DatatypeProperty ;
    rdfs:label "prov_startedAtTime" ;
    rdfs:domain qo:SuloProcess ;
    rdfs:range xsd:dateTime ;
    skos:definition "The time at which an activity started." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:QuestionnaireResponseStatusEnum a owl:Class ;
    rdfs:label "qo_QuestionnaireResponseStatusEnum" ;
    owl:unionOf ( fhir:questionnaire-answers-status-in-progress fhir:questionnaire-answers-status-completed fhir:questionnaire-answers-status-amended fhir:questionnaire-answers-status-entered-in-error fhir:questionnaire-answers-status-stopped ) ;
    skos:definition "The questionnaire response status must be one of the following: 'in-progress', 'completed', 'amended', 'entered-in-error' or 'stopped'." ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    linkml:permissible_values fhir:questionnaire-answers-status-amended,
        fhir:questionnaire-answers-status-completed,
        fhir:questionnaire-answers-status-entered-in-error,
        fhir:questionnaire-answers-status-in-progress,
        fhir:questionnaire-answers-status-stopped .

qo:SarefProperty a owl:Class ;
    rdfs:label "saref_Property" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fhir:referenceRange ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:FhirReferenceRange ;
            owl:onProperty fhir:referenceRange ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fhir:referenceRange ],
        qo:ProvEntity ;
    skos:definition "Identifiable qualities of features of interest that can be target of devices, such as observed or controlled. A property can apply to different features of interest." ;
    skos:exactMatch saref:Property ;
    skos:inScheme <https://ns.faqir.org/q-o> .

saref:hasProperty a owl:ObjectProperty ;
    rdfs:label "saref_hasProperty" ;
    rdfs:range qo:SarefProperty ;
    skos:definition "Links a feature kind or a feature of interest to one of its properties." ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    skos:mappingRelation ssn:hasProperty .

saref:isMeasuredIn a owl:DatatypeProperty ;
    rdfs:label "saref_isMeasuredIn" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^ucum:" ] ) ] ) ] ;
    skos:definition "A relationship identifying the unit of measure used for a certain entity." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:QoQuestion a owl:Class ;
    rdfs:label "qo_Question" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcterms:creator ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:ProvOrganization ;
            owl:onProperty dcterms:creator ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty qo:multivalued ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:NumericalParams ;
            owl:onProperty qo:numericalParams ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:intervalParams ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty qo:tag ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:numericalParams ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:codingParams ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:intervalParams ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty qo:codingOrdinal ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:codingOrdinal ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:ValueCoding ;
            owl:onProperty qo:codingParams ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty prov:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:codingOrdinal ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty qo:tag ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:numericalParams ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qo:multivalued ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:IntervalParams ;
            owl:onProperty qo:intervalParams ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qo:multivalued ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:QuestionType ;
            owl:onProperty prov:type ],
        qo:ProvEntity ;
    skos:definition "An individual inquiry item within an instrument that specifies an information requirement and constrains the acceptable response format." ;
    skos:exactMatch qo:Question ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    skos:narrowMatch <http://hl7.org/fhir/Questionnaire.item.where(type='question')> .

qo:SarefPropertyValue a owl:Class ;
    rdfs:label "saref_PropertyValue" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty fhir:valueReference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fhir:valueRatio ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fhir:valueRange ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fhir:valueRatio ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty saref:hasValue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fhir:valuePeriod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty prov:atTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fhir:valueAttachment ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty prov:atTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fhir:valueCodeableConcept ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty saref:isValueOfProperty ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty saref:isValueOfProperty ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fhir:valueReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:SarefProperty ;
            owl:onProperty saref:isValueOfProperty ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fhir:valueRange ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fhir:valuePeriod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty saref:hasValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( xsd:integer xsd:float xsd:double xsd:decimal xsd:date xsd:dateTime xsd:anyURI xsd:string ) ] ;
            owl:onProperty saref:hasValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty fhir:valueAttachment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:atTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fhir:valueAttachment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fhir:valueReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:ValueCoding ;
            owl:onProperty fhir:valueCodeableConcept ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fhir:valueCodeableConcept ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:FhirValueRatio ;
            owl:onProperty fhir:valueRatio ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:FhirReferenceRange ;
            owl:onProperty fhir:valueRange ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:TimeInterval ;
            owl:onProperty fhir:valuePeriod ],
        qo:OwlThing ;
    skos:definition "Describes the value for a property. The property value is optionally linked to its value expressed as an RDF literal (DP saref:hasValue), optionally to the unit of measurement (OP saref:isMeasuredIn), and optionally to the properties or properties of interest it is a value of (OP saref:isValueOfProperty)." ;
    skos:exactMatch saref:PropertyValue ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    skos:mappingRelation sosa:Result .

saref:hasPropertyValue a owl:ObjectProperty ;
    rdfs:label "saref_hasPropertyValue" ;
    rdfs:range qo:SarefPropertyValue ;
    skos:definition "Links a feature kind, a feature of interest, or a property of interest, to a property value." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:FoafAgent a owl:Class ;
    rdfs:label "foaf_Agent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty prov:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcterms:creator ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:FoafAgent ;
            owl:onProperty dcterms:creator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:generatedAtTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:SarefProperty ;
            owl:onProperty saref:hasProperty ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:OwlThing ;
            owl:onProperty dcterms:isPartOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty fhir:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:OwlThing ;
            owl:onProperty dcterms:hasPart ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fhir:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty prov:generatedAtTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty saref:hasProperty ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcterms:isPartOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:SarefPropertyValue ;
            owl:onProperty saref:hasPropertyValue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty saref:hasPropertyValue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcterms:hasPart ],
        qo:OwlThing ;
    skos:definition "An agent (eg. person, group, software or physical artifact)." ;
    skos:exactMatch foaf:Agent ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    skos:mappingRelation prov:Agent .

qo:QuestionType a owl:Class ;
    rdfs:label "qo_QuestionType" ;
    owl:unionOf ( <http://hl7.org/fhir/item-type#coding> qo:open-choice qo:numberInterval <http://hl7.org/fhir/item-type#decimal> <http://hl7.org/fhir/item-type#time> <http://hl7.org/fhir/item-type#dateTime> <http://hl7.org/fhir/item-type#string> ) ;
    skos:definition "Specifies the structural classification and data-type constraints governing acceptable inputs for an inquiry item." ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    linkml:permissible_values <http://hl7.org/fhir/item-type#coding>,
        <http://hl7.org/fhir/item-type#dateTime>,
        <http://hl7.org/fhir/item-type#decimal>,
        <http://hl7.org/fhir/item-type#string>,
        <http://hl7.org/fhir/item-type#time>,
        qo:numberInterval,
        qo:open-choice .

qo:order a owl:DatatypeProperty ;
    rdfs:label "qo_order" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
    skos:definition "An integer specifying the sequence or display arrangement (1-based index) of an item within a container." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

dcterms:created a owl:DatatypeProperty ;
    rdfs:label "dcterms_created" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The date and time when the entity was created." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

dcterms:modified a owl:DatatypeProperty ;
    rdfs:label "dcterms_modified" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The date and time when the entity was last updated." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

fhir:status a owl:DatatypeProperty ;
    rdfs:label "fhir_status" ;
    rdfs:subPropertyOf saref:hasPropertyValue ;
    skos:definition "A code specifying the state of the observation/procedure/questionnaire... Generally, this will be the in-progress or completed state." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:SuloProcess a owl:Class ;
    rdfs:label "sulo_Process" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty saref:hasPropertyValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:SarefProperty ;
            owl:onProperty saref:hasProperty ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcterms:isPartOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty prov:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcterms:hasPart ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:FoafAgent ;
            owl:onProperty dcterms:creator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fhir:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty saref:hasProperty ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:OwlThing ;
            owl:onProperty dcterms:hasPart ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty prov:startedAtTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcterms:creator ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty fhir:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:SarefPropertyValue ;
            owl:onProperty saref:hasPropertyValue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:endedAtTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty prov:endedAtTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty prov:endedAtTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty prov:startedAtTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:OwlThing ;
            owl:onProperty dcterms:isPartOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:startedAtTime ],
        qo:OwlThing ;
    skos:definition "a process is a entity that unfolds in time, has temporal parts, and has objects that participate in the process." ;
    skos:exactMatch sulo:Process ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    skos:mappingRelation prov:Activity .

dcterms:hasPart a owl:ObjectProperty ;
    rdfs:label "dcterms_hasPart" ;
    rdfs:range qo:OwlThing ;
    owl:inverseOf dcterms:isPartOf ;
    skos:definition "A related resource that is included either physically or logically in the described resource." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

dcterms:isPartOf a owl:ObjectProperty ;
    rdfs:label "dcterms_isPartOf" ;
    rdfs:range qo:OwlThing ;
    owl:inverseOf dcterms:hasPart ;
    skos:definition "A related resource in which the described resource is physically or logically included." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

prov:type a owl:DatatypeProperty ;
    rdfs:label "prov_type" ;
    rdfs:range xsd:anyURI ;
    skos:definition "The attribute prov:type provides further typing information for any construct with an optional set of attribute-value pairs." ;
    skos:exactMatch rdf:type,
        sphn:hasTypeCode ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    skos:narrowMatch schema1:procedureType .

dcterms:creator a owl:ObjectProperty ;
    rdfs:label "dcterms_creator" ;
    rdfs:range qo:FoafAgent ;
    skos:definition "An entity responsible for making the resource." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:ProvEntity a owl:Class ;
    rdfs:label "prov_Entity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcterms:created ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:SarefPropertyValue ;
            owl:onProperty saref:hasPropertyValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty dcterms:created ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty prov:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcterms:modified ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:generatedAtTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty fhir:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:FoafAgent ;
            owl:onProperty prov:wasAttributedTo ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcterms:created ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcterms:hasPart ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:OwlThing ;
            owl:onProperty dcterms:isPartOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty saref:hasProperty ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty saref:hasPropertyValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty dcterms:modified ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcterms:isPartOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:SarefProperty ;
            owl:onProperty saref:hasProperty ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:OwlThing ;
            owl:onProperty dcterms:hasPart ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcterms:modified ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcterms:creator ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty prov:generatedAtTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:wasAttributedTo ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:FoafAgent ;
            owl:onProperty dcterms:creator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fhir:status ],
        qo:OwlThing ;
    skos:definition "An entity is a physical, digital, conceptual, or other kind of thing with some fixed aspects; entities may be real or imaginary." ;
    skos:exactMatch prov:Entity ;
    skos:inScheme <https://ns.faqir.org/q-o> ;
    skos:mappingRelation sulo:Object .

saref:hasValue a owl:DatatypeProperty ;
    rdfs:label "saref_hasValue" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( xsd:integer xsd:float xsd:double xsd:decimal xsd:date xsd:dateTime xsd:anyURI xsd:string ) ] ;
    skos:definition "Value of a property value expressed as an RDF literal. Note that, even if decimal values are expected, values could use other datatypes." ;
    skos:inScheme <https://ns.faqir.org/q-o> .

qo:OwlThing a owl:Class ;
    rdfs:label "owl_Thing" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom qo:ProvEntity ;
            owl:onProperty prov:hadPrimarySource ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty owl:versionInfo ],
        [ a owl:Restriction ;
            owl:allValuesFrom qo:SuloProcess ;
            owl:onProperty prov:wasGeneratedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty rdfs:comment ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty rdfs:label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty owl:versionInfo ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty rdfs:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:hadPrimarySource ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty owl:versionInfo ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:wasGeneratedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty rdfs:comment ] ;
    skos:definition "This defines IOT as the set of OWL individuals." ;
    skos:exactMatch owl:Thing ;
    skos:inScheme <https://ns.faqir.org/q-o> .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty qo:codingParams ;
            owl:someValuesFrom owl:Thing ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty prov:type ;
                owl:someValuesFrom [ a rdfs:Datatype ;
                        owl:oneOf ( "choice" "openChoice" ) ] ] qo:QoQuestion ) .

[] rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty qo:intervalParams ;
                        owl:someValuesFrom owl:Thing ] [ a owl:Restriction ;
                        owl:onProperty qo:numericalParams ;
                        owl:someValuesFrom owl:Thing ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty prov:type ;
                owl:someValuesFrom "numberInterval" ] qo:QoQuestion ) .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty qo:numericalParams ;
            owl:someValuesFrom owl:Thing ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty prov:type ;
                owl:someValuesFrom "decimal" ] qo:QoQuestion ) .

