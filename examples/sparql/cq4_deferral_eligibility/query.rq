# CQ4 - Deferral eligibility
# Which questions in a new questionnaire can be automatically deferred or
# pre-filled based on valid, consent-authorized historical answers?
#
# For every atomic qo:Question of the new questionnaire (as in CQ1), the
# patient's latest answer to that same qo:Question recorded before the new
# session is retrieved, in whichever questionnaire it was given:
#   qo:QuestionnaireResponse --prov:wasAttributedTo--> patient
#   qo:QuestionnaireResponse --qo:hasAnswer--> qo:Answer --qo:toQuestion--> qo:OrderedQuestion --qo:question--> qo:Question
# Its validity is evaluated as in CQ3, on the chain of the context where it
# was recorded (most restrictive expiry wins; hard expiry invalidates, soft
# expiry only recommends re-administration). A question is deferrable when
# that answer exists and no hard expiry has passed; questions that must be
# asked again are filtered out. ?reAdministrationRecommended flags the
# deferrable answers whose soft expiry has passed.
# Consent is not modelled in the schema, so authorization for reuse is
# assumed to be checked outside this query.

PREFIX qo:    <https://ns.faqir.org/q-o#>
PREFIX prov:  <http://www.w3.org/ns/prov#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX ucum:  <https://unitsofmeasure.org/>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>

SELECT ?questionnaire ?containerOrder ?order ?question ?label
       ?answer ?answerValue ?isEmpty ?generatedAt
       ?validUntil ?hardValidUntil ?deferrable ?reAdministrationRecommended
       ?validityChain ?conditionalValidity
WHERE {
  # New questionnaire, patient and timestamp of the new survey session (replace as needed)
  VALUES (?questionnaire ?patient ?sessionTime) {
    (<https://pods.faqir.org/questionnaire_WHOQOL_BREF> <https://pods.faqir.org/patient123> "2026-07-10T09:34:10.168913+00:00"^^xsd:dateTime)
    #(<https://pods.faqir.org/questionnaire_EQ_5D_5L> <https://pods.faqir.org/patient123> "2026-07-10T09:34:10.168913+00:00"^^xsd:dateTime)
  }

  ?questionnaire a qo:Questionnaire .

  # Atomic questions of the new questionnaire and their position
  ?questionnaire (qo:hasOrderedSection/qo:section)* ?container .
  ?container qo:hasOrderedQuestion ?targetOrderedQuestion .
  ?targetOrderedQuestion qo:question ?question ;
                         qo:order    ?order .
  OPTIONAL {
    ?containerWrapper qo:section ?container ;
                      qo:order   ?containerOrder .
  }

  # Human-readable label (untagged or English, other languages are left out for clarity)
  OPTIONAL {
    ?question rdfs:label ?label .
    FILTER(lang(?label) = "" || langMatches(lang(?label), "en"))
  }

  # Patient's latest answer to the same question before the new session
  OPTIONAL {
    ?response prov:wasAttributedTo ?patient ;
              qo:hasAnswer ?answer .
    ?answer a qo:Answer ;
            qo:toQuestion/qo:question ?question ;
            prov:generatedAtTime ?generatedAt .
    OPTIONAL { ?answer qo:answerValue ?answerValue }
    OPTIONAL { ?answer qo:isEmpty     ?isEmptyDeclared }

    # Validity of every answer in the context where it was recorded (CQ3)
    {
      # Aggregates turn into errors if any row is unbound, so levels without a
      # declaration use a far-future sentinel date or an empty string instead
      SELECT ?answer
             (MIN(?expiresAt)     AS ?minExpiresAt)
             (MIN(?hardExpiresAt) AS ?minHardExpiresAt)
             (GROUP_CONCAT(?levelDescription; SEPARATOR="") AS ?validityChainRaw)
             (GROUP_CONCAT(?conditionDescription; SEPARATOR="") AS ?conditionalValidityRaw)
      WHERE {
        ?answer a qo:Answer ;
                prov:generatedAtTime ?answeredAt ;
                qo:toQuestion ?orderedQuestion .
        ?orderedQuestion qo:question ?answeredQuestion .
        ?answerResponse qo:hasAnswer ?answer ;
                        qo:responds  ?answerQuestionnaire .

        # Container (questionnaire or section) holding the answered question
        ?answerQuestionnaire (qo:hasOrderedSection/qo:section)* ?answerContainer .
        ?answerContainer qo:hasOrderedQuestion ?orderedQuestion .

        # Every level of the chain that contains the answered question
        {
          ?orderedQuestion qo:question ?level .
        }
        UNION
        {
          ?answer qo:toQuestion ?level .
        }
        UNION
        {
          # The questionnaire and every section between it and the container
          ?answerQuestionnaire (qo:hasOrderedSection/qo:section)* ?level .
          ?level (qo:hasOrderedSection/qo:section)* ?answerContainer .
        }
        UNION
        {
          # The ordered-section wrappers along that same path
          ?answerQuestionnaire (qo:hasOrderedSection/qo:section)* ?parent .
          ?parent qo:hasOrderedSection ?level .
          ?level  qo:section ?childSection .
          ?childSection (qo:hasOrderedSection/qo:section)* ?answerContainer .
        }

        VALUES ?levelType { qo:Questionnaire qo:OrderedSection qo:Section qo:OrderedQuestion qo:Question }
        ?level a ?levelType .

        OPTIONAL { ?level qo:conditionalValidity ?condition }
        OPTIONAL { ?level qo:hardValidity ?hardDeclared }
        OPTIONAL {
          ?level qo:temporalValidity ?duration .
          ?duration saref:hasValue     ?durationValue ;
                    saref:isMeasuredIn ?durationUnit .
          VALUES (?durationUnit ?secondsPerUnit) {
            (ucum:s   1)
            (ucum:min 60)
            (ucum:h   3600)
            (ucum:d   86400)
            (ucum:wk  604800)
            (ucum:mo  2629800)
            (ucum:a   31557600)
          }
        }

        # Expiry of this level, as generation time + duration in seconds
        BIND("9999-12-31T23:59:59Z"^^xsd:dateTime AS ?never)
        BIND(COALESCE(?hardDeclared, false) AS ?hard)
        BIND(COALESCE(?answeredAt + STRDT(CONCAT("PT", STR(xsd:decimal(?durationValue * ?secondsPerUnit)), "S"),
                                          xsd:dayTimeDuration),
                      ?never) AS ?expiresAt)
        BIND(IF(?hard, ?expiresAt, ?never) AS ?hardExpiresAt)

        # Human-readable trace, each entry prefixed with the separator
        BIND(COALESCE(CONCAT(" | ", STRAFTER(STR(?levelType), "#"), " <", STR(?level), "> ",
                             STR(?durationValue), " ", STRAFTER(STR(?durationUnit), STR(ucum:)),
                             IF(?hard, " (hard)", " (soft)")),
                      "") AS ?levelDescription)
        BIND(COALESCE(CONCAT(" | ", STRAFTER(STR(?levelType), "#"), " <", STR(?level), "> ", ?condition),
                      "") AS ?conditionDescription)
      }
      GROUP BY ?answer
    }

    # Only historical answers, and only the latest one per question
    FILTER(?generatedAt <= ?sessionTime)
    FILTER NOT EXISTS {
      ?laterResponse prov:wasAttributedTo ?patient ;
                     qo:hasAnswer ?laterAnswer .
      ?laterAnswer qo:toQuestion/qo:question ?question ;
                   prov:generatedAtTime ?laterGeneratedAt .
      FILTER(?laterGeneratedAt > ?generatedAt && ?laterGeneratedAt <= ?sessionTime)
    }
  }

  # Turn the sentinels back into unbound values and drop the leading separator
  BIND("9999-12-31T23:59:59Z"^^xsd:dateTime AS ?never)
  BIND(IF(?minExpiresAt     = ?never, ?unbound, ?minExpiresAt)     AS ?validUntil)
  BIND(IF(?minHardExpiresAt = ?never, ?unbound, ?minHardExpiresAt) AS ?hardValidUntil)
  BIND(IF(?validityChainRaw       = "", ?unbound, STRAFTER(?validityChainRaw, " | "))       AS ?validityChain)
  BIND(IF(?conditionalValidityRaw = "", ?unbound, STRAFTER(?conditionalValidityRaw, " | ")) AS ?conditionalValidity)
  BIND(IF(BOUND(?answer), COALESCE(?isEmptyDeclared, false), ?unbound) AS ?isEmpty)

  # Hard expiry invalidates the answer; soft expiry only recommends re-administration
  BIND(BOUND(?answer) && ?sessionTime < ?minHardExpiresAt AS ?deferrable)
  BIND(?sessionTime >= ?minExpiresAt AS ?reAdministrationRecommended)

  # Keep only the questions that do not have to be asked again
  FILTER(?deferrable)
}
ORDER BY ?questionnaire COALESCE(?containerOrder, 0) ?order
