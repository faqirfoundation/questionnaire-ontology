@prefix faqir: <https://faqir.org/datamodel/> .
@prefix ns1: <https://w3id.org/faqir/datamodel/questionnaire/classes/> .
@prefix ns2: <https://w3id.org/faqir/datamodel/core/types/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://pods.faqir.org/TFJSK> a faqir:ScoreDefinition ;
    faqir:scoreDefinitionAuthoredByOrg <https://www.moveup.care/> ;
    faqir:scoreDefinitionHasScoreValue <https://pods.faqir.org/svTFJSK> ;
    faqir:scoreDefinitionType xsd:integer ;
    faqir:scoreDefinitionUsesQuestion <https://pods.faqir.org/FoIn0>,
        <https://pods.faqir.org/Fowh1>,
        <https://pods.faqir.org/Fowh10>,
        <https://pods.faqir.org/Fowh11>,
        <https://pods.faqir.org/Fowh2>,
        <https://pods.faqir.org/Fowh3>,
        <https://pods.faqir.org/Fowh4>,
        <https://pods.faqir.org/Fowh5>,
        <https://pods.faqir.org/Fowh6>,
        <https://pods.faqir.org/Fowh7>,
        <https://pods.faqir.org/Fowh8>,
        <https://pods.faqir.org/Fowh9> ;
    ns1:scoreDefinitionFormula "Unknown" ;
    ns1:scoreDefinitionIntervalParams [ a faqir:IntervalParams ;
            ns2:maxValue "100.0"^^xsd:float ;
            ns2:minValue "0.0"^^xsd:float ] ;
    ns1:scoreDefinitionLabel "Total Forgotten Joint Score Knee (/100) (een hoge score geeft een hogere mate van “vergeten” weer, dat wil zeggen een lager bewustzijn van het kunstgewricht) score" .

