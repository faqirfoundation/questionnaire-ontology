<https://pods.faqir.org/qrquestion_06_EQ_5D_5L_02_en> a faqir:QuestionRepresentation ;
    faqir:questionRepresentationOfQuestion <https://pods.faqir.org/question_06_EQ_5D_5L_02> ;
    ns2:questionRepresentationLanguage "en" ;
    ns2:questionRepresentationText "Under each heading, please tick the ONE box that best describes your health TODAY. SELF-CARE." .

<https://pods.faqir.org/question_06_EQ_5D_5L_02> a faqir:Question ;
    faqir:questionAuthoredByOrg <https://euroqol.org/> ;
    faqir:questionHasAnswer <https://pods.faqir.org/answer_06_EQ_5D_5L_02_01>,
        <https://pods.faqir.org/answer_06_EQ_5D_5L_02_02>,
        <https://pods.faqir.org/answer_06_EQ_5D_5L_02_03> ;
