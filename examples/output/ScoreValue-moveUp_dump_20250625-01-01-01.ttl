@prefix faqir: <https://faqir.org/datamodel/> .
@prefix ns1: <https://w3id.org/faqir/datamodel/questionnaire/classes/> .
@prefix ns2: <https://w3id.org/faqir/datamodel/core/types/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://pods.faqir.org/svTFJSK> a faqir:ScoreValue ;
    faqir:scoreDefinitionType xsd:integer ;
    faqir:scoreValueBasedOnScoreDefinition <https://pods.faqir.org/TFJSK> ;
    faqir:scoreValueDerivedFromQuestionnaireResponse <https://pods.faqir.org/moveup-id/d60d04dbe47a164a> ;
    ns1:scoreValueNumerical [ a faqir:ValueNumerical ;
            ns2:numericalValue 2.0 ] ;
    ns1:scoreValueStatus "valid" ;
    ns1:scoreValueTimeStamp "2021-08-27T00:00:01.000800+00:00"^^xsd:dateTime .

