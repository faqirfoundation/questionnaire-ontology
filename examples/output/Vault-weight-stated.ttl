@prefix datamodel: <https://w3id.org/faqir/datamodel/> .
@prefix loinc: <https://loinc.org/> .
@prefix ns1: <https://w3id.org/faqir/datamodel/vault/> .
@prefix ns2: <https://w3id.org/faqir/datamodel/core/types/> .
@prefix ns3: <https://w3id.org/faqir/datamodel/core/versions/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://pods.faqir.org/123> a datamodel:vault ;
    ns3:lastUpdated "2023-10-01T12:00:00+00:00"^^xsd:dateTime ;
    ns1:birthdate "2000-07-11T10:35:00+00:00"^^xsd:dateTime ;
    ns1:vaultManagedByOrg <https://www.faqir.org> ;
    ns1:weight [ a ns1:Weight ;
            ns2:numericalValue 100.0 ;
            ns1:weightType loinc:3142-7 ] .

