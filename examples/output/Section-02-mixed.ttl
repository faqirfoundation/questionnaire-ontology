<https://pods.faqir.org/section_02_EQ_5D_5L> a faqir:Section ;
    faqir:sectionHasOrderedQuestion <https://pods.faqir.org/orderedquestion_05_EQ_5D_5L_01_s02>,
        <https://pods.faqir.org/orderedquestion_06_EQ_5D_5L_02_s02> ;
    faqir:sectionHasOrderedSection <https://pods.faqir.org/orderedsection_03_EQ_VAS_s02> ;
    ns1:sectionLabel "Section 02: EQ-5D-5L first 2 questions & VAS nested." .

<https://pods.faqir.org/orderedquestion_05_EQ_5D_5L_01_s02> a faqir:OrderedQuestion ;
    faqir:orderedQuestionHasQuestion <https://pods.faqir.org/question_05_EQ_5D_5L_01> ;
    ns1:questionOrder 1 .

<https://pods.faqir.org/orderedquestion_06_EQ_5D_5L_02_s02> a faqir:OrderedQuestion ;
    faqir:orderedQuestionHasQuestion <https://pods.faqir.org/question_06_EQ_5D_5L_02> ;
    ns1:questionOrder 2 .

<https://pods.faqir.org/orderedsection_03_EQ_VAS_s02> a faqir:OrderedSection ;
