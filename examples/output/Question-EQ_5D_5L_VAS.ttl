@prefix faqir: <https://faqir.org/datamodel/> .
@prefix fhir: <https://www.hl7.org/fhir/> .
@prefix ns1: <https://w3id.org/faqir/datamodel/core/types/> .
@prefix ns2: <https://w3id.org/faqir/datamodel/questionnaire/classes/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://pods.faqir.org/question_EQ_5D_5L_EQ_VAS> a faqir:Question ;
    faqir:questionAuthoredByOrg <https://euroqol.org/> ;
    faqir:questionHasAnswer <https://pods.faqir.org/answer_EQ_5D_5L_EQ_VAS_a01> ;
    faqir:questionInOrderedQuestion <https://pods.faqir.org/orderedquestion_EQ_5D_5L_EQ_VAS> ;
    faqir:questionType fhir:number ;
    ns2:questionIntervalParams [ a faqir:IntervalParams ;
            ns1:maxLabel "The best health you can imagine" ;
            ns1:maxValue "100.0"^^xsd:float ;
            ns1:minLabel "The worst health you can imagine" ;
            ns1:minValue "0.0"^^xsd:float ] ;
    ns2:questionLabel """"We would like to know how good or bad your health is TODAY.
This scale is numbered from 0 to 100.
100 means the *best* health you can imagine.
0 means the *worst* health you can imagine.
Mark an X on the scale to indicate how your health is TODAY.
Now, please write the number you marked on the scale."
""" ;
    ns2:questionNumericalParams [ a faqir:NumericalParams ;
            ns1:numericalPrecision 0 ] ;
    ns2:questionRequired false ;
    ns2:questionTag "q_EQ_5D_5L_EQ_VAS" .

